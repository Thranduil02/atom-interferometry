"""
Alias suppression factor vs N out to N = 10^6, for a single jitter amplitude.

Same setup as cadence_alias_ratio (fig2_final AICE parameters, 0.05 Hz vertical
oscillator, T_c ~ Uniform(T_nom - delta, T_nom + delta), no noise): the ratio
of the first alias (f_s - f_sig) height to the main-peak (f_sig) height.

Out to N = 10^6 the exact Lomb-Scargle sum used in cadence_alias_ratio (cost
~ N x number of frequencies, i.e. ~N^2) is far too slow, so the spectrum near
each peak is computed with a fast gridded FFT instead:

  * the data are demodulated to baseband at the window centre,
    z_k = (y_k - mean) exp(-2 pi i f_c t_k)  (exact, at the true jittered times);
  * the remaining kernel exp(-2 pi i nu t), |nu| <= half-window, is smooth on
    the scale of the time grid, so each sample is spread onto 4 neighbouring
    points of a coarse regular grid with cubic-Lagrange weights
    ("extirpolation", Press & Rybicki) and one zero-padded FFT gives the
    spectrum on a grid of spacing 1/(OVERSAMPLE * T_span).

This is the classical (Schuster) periodogram rather than the tau-shifted
Lomb-Scargle; the two agree to well under a percent here because the
sampling has no coherent 2f structure at either peak.

Heights are the maximum of sqrt(S) inside a fixed window around each peak.
"""

import time

import numpy as np
import matplotlib.pyplot as plt

# ── constants (AICE params from fig2_final.py) ─────────────────────────────────
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11; g = 9.81
u0 = 24.5          # launch speed [m/s]
T = 2.5            # half-interferometer time [s]
dt = 0.01
delta_r = 70.0     # gradiometer baseline: IFO2 sits 70 m above IFO1

# source (fig2_final src_common), vertical linear oscillator
M, D_0, h_0, A = 1.0, 3.0, 1.0, 0.5
f_sig = 0.05

T_fly = 2 * T
N_fly = int(round(T_fly / dt))
t_local = np.arange(N_fly) * dt

T_nom   = 5.5                  # nominal cycle; >= T_fly + jitter
f_s     = 1.0 / T_nom
f_alias = f_s - f_sig          # first alias of the oscillator

# ── run settings ───────────────────────────────────────────────────────────────
DELTA          = 0.1           # jitter amplitude [s]
N_MAX          = 1_820_000      # ~1e7 s of observing time at the 5.5 s cycle
N_STEP         = 5_000         # N = 5,000, 10,000, ..., N_MAX
Ns             = list(range(N_STEP, N_MAX + 1, N_STEP))
N_REALISATIONS = 1             # jitter draws per N (>1 adds a min-max band)

OVERSAMPLE = 4                 # frequency-grid points per native resolution element 1/T_span
MAIN_HALF  = 0.002             # [Hz] window half-width around f_sig
ALIAS_HALF = 0.010             # [Hz] window half-width around the alias

# ── trajectory helpers ─────────────────────────────────────────────────────────
def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0 + k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _  = atom_path(p1[-1] if len(p1) else float(floor),
                        v1 + k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly - len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G * M / np.sqrt(D_0**2 + (z - h)**2)

lower1_loc = arm_positions(0, 0, upper=False)
upper1_loc = arm_positions(0, 0, upper=True)
lower2_loc = arm_positions(delta_r, delta_r, upper=False)
upper2_loc = arm_positions(delta_r, delta_r, upper=True)

def phases_for(t_starts, chunk=10_000):
    out = np.empty(len(t_starts))
    for i0 in range(0, len(t_starts), chunk):
        t_abs = t_starts[i0:i0 + chunk, None] + t_local[None, :]
        h = h_0 + A * np.cos(2*np.pi * f_sig * t_abs)
        pd1 = V(upper1_loc, h) - V(lower1_loc, h)
        pd2 = V(upper2_loc, h) - V(lower2_loc, h)
        out[i0:i0 + chunk] = (m_atom / hbar) * np.trapezoid(pd1 - pd2, t_local, axis=1)
    return out

def random_cadence(delta, N_cycles, seed=0):
    rng = np.random.default_rng(seed)
    T_cycles = rng.uniform(T_nom - delta, T_nom + delta, N_cycles)
    return np.concatenate([[0.0], np.cumsum(T_cycles[:-1])]) + T_fly

# ── fast windowed periodogram (gridded FFT) ────────────────────────────────────
def window_amplitude(t, y, f_c, half):
    """sqrt of the classical periodogram on a grid of spacing 1/(OVERSAMPLE*T_span)
    covering [f_c - half, f_c + half]; returns the amplitude array (arbitrary but
    window-independent normalisation, so heights from different windows compare)."""
    T_span = t[-1] - t[0]
    h = 1.0 / (8 * half)                          # grid step: kernel phase per step <= 2*pi/8
    M = int(np.ceil(OVERSAMPLE * T_span / h))
    M += M % 2
    z = (y - y.mean()) * np.exp(-2j * np.pi * f_c * t)
    x = (t - t[0]) / h
    base = np.floor(x).astype(np.int64) - 1       # 4 grid points base .. base+3
    p = x - np.floor(x)                           # fractional position in [0, 1)
    # cubic Lagrange weights for nodes -1, 0, 1, 2 evaluated at p
    w = np.stack([
        -p * (p - 1) * (p - 2) / 6,
        (p + 1) * (p - 1) * (p - 2) / 2,
        -(p + 1) * p * (p - 2) / 2,
        (p + 1) * p * (p - 1) / 6,
    ])
    grid = np.zeros(M, dtype=complex)
    for k in range(4):
        idx = base + k
        ok = (idx >= 0) & (idx < M)
        grid.real += np.bincount(idx[ok], weights=(w[k] * z.real)[ok], minlength=M)
        grid.imag += np.bincount(idx[ok], weights=(w[k] * z.imag)[ok], minlength=M)
    F = np.fft.fft(grid)
    nu = np.fft.fftfreq(M, d=h)
    sel = np.abs(nu) <= half
    return np.abs(F[sel]) / np.sqrt(len(t))

def peak_ratio(delta, n, seed):
    t = random_cadence(delta, n, seed=seed)
    y = phases_for(t - T_fly)
    main  = window_amplitude(t, y, f_sig,   MAIN_HALF).max()
    alias = window_amplitude(t, y, f_alias, ALIAS_HALF).max()
    return alias / main

# ── ratio vs N, with a progress bar (cost ~ N, so weight by N) ─────────────────
total_work = N_REALISATIONS * sum(Ns)
done_work, t_start = 0.0, time.time()

def show_progress(label):
    frac = done_work / total_work
    el = time.time() - t_start
    eta = el * (1 - frac) / frac if frac > 0 else float('nan')
    bar = '#' * int(30 * frac) + '-' * (30 - int(30 * frac))
    print(chr(13) + f"[{bar}] {100*frac:5.1f}%  elapsed {el/60:6.1f} min  ETA {eta/60:6.1f} min  {label}   ",
          end='', flush=True)

per_draw = np.empty((len(Ns), N_REALISATIONS))
for i, n in enumerate(Ns):
    for j in range(N_REALISATIONS):
        show_progress(f"delta={DELTA:g}  N={n:,}  draw {j+1}/{N_REALISATIONS}")
        per_draw[i, j] = peak_ratio(DELTA, n, seed=j)
        done_work += n
show_progress("done")
print()
mean, lo, hi = per_draw.mean(1), per_draw.min(1), per_draw.max(1)
print(f"delta = {DELTA:g} s: ratio {mean[0]:.4f} (N={Ns[0]:,}) -> {mean[-1]:.4f} (N={Ns[-1]:,})")

# ── plot (style of fig2_final.py) ──────────────────────────────────────────────
COLOR = '#c1272d'   # fig2_final red

fig, ax = plt.subplots(figsize=(6, 4), dpi=200)
if N_REALISATIONS > 1:
    ax.fill_between(Ns, lo, hi, color=COLOR, alpha=0.2, lw=0)   # min-max over draws
ax.plot(Ns, mean, '-', color=COLOR, lw=1.2,
        label=rf'$\delta = \pm{DELTA:g}\,\mathrm{{s}}$')
ax.set_xlim(Ns[0], Ns[-1])
ax.set_ylim(0, 1.1 * hi.max())
ax.set_xlabel('$N$', fontsize=12)
ax.set_ylabel(r'$\sqrt{S_{\mathrm{alias}}/S_{\mathrm{peak}}}$', fontsize=12)
ax.tick_params(labelsize=11)
ax.legend(fontsize=8, loc='best', frameon=False)
fig.tight_layout()

np.savez('alias_suppression_factor_results.npz', Ns=Ns, per_draw=per_draw, delta=DELTA)
fig.savefig(r'C:\Users\Georg\Desktop\alias_suppression_factor.png', dpi=200)

plt.show()
