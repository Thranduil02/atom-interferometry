# -*- coding: utf-8 -*-
"""
Scaffold GGN simulation — multiple simultaneous oscillation modes.

Each mode shares the same linear amplitude profile (A_bottom at z=0,
A_top at z=H_total) but has its own frequency and scale factor.
The total x-displacement of member i at time t is:

    x_i(t) = A_i * alpha(t),   alpha(t) = Σ_m scale_m * cos(2π f_m t + phase_m)

Because alpha is still a scalar, the same single V(alpha, z) grid
from scaffold works exactly — only alpha_func and its range change.
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy import integrate
from scipy.integrate import quad
from scipy.interpolate import RectBivariateSpline, interp1d

# ── Constants ─────────────────────────────────────────────────────────────────
G              = 6.67430e-11
u_initial      = 3.86
m_atom         = 1.46e-25
hbar           = 1.055e-34
wavelength     = 698e-9
wavenumber     = 2 * np.pi / wavelength
T              = 0.73
n_kicks        = 1000
velocity_boost = n_kicks * hbar * wavenumber / m_atom
g              = 9.81

# ── Steel scaffold parameters ─────────────────────────────────────────────────
rho_steel = 7850.0
R_edge    = 0.0338
L_cube    = 1.0
N_cubes   = 10
H_total   = N_cubes * L_cube   # 10 m

M_edge = rho_steel * np.pi * R_edge**2 * L_cube
print(f"Steel edge: R={R_edge*1000:.0f} mm, L={L_cube:.1f} m, M_edge={M_edge:.2f} kg")

# ── Build scaffold member list ────────────────────────────────────────────────
h = L_cube / 2.0

members = []

H_col = N_cubes * L_cube
M_col = rho_steel * np.pi * R_edge**2 * H_col
for sy in (-1, 1):
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': sy * h, 'dz': H_col / 2.0,
            'M': M_col, 'R': R_edge, 'H': H_col, 'axis': 'z'
        })

for k in range(N_cubes + 1):
    z_ring = k * L_cube
    for sy in (-1, 1):
        members.append({
            'dx': 0.0, 'dy': sy * h, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'x'
        })
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': 0.0, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'y'
        })

total_mass = sum(m['M'] for m in members)
print(f"Tower: {len(members)} members, total mass = {total_mass:.1f} kg")

# ── Per-member oscillation amplitude (linear in z) ───────────────────────────
A_bottom = 1e-6   # 1 µm  at z = 0
A_top    = 1e-4   # 1 mm  at z = H_total

amplitudes = np.array([
    A_bottom + (A_top - A_bottom) * m['dz'] / H_total
    for m in members
])

# ── Oscillation modes ─────────────────────────────────────────────────────────
# Each mode: frequency [Hz], scale (multiplies the base amplitude profile),
# and an optional phase offset [rad].
modes = [
    dict(f=2.30, scale=1.0,  phase=0.0),
    dict(f=2.34,  scale=1,  phase=0.0),
    dict(f=12.7, scale=1,  phase=0.0),
    dict(f=35.1, scale=1, phase=0),
    dict(f=37.0, scale=1, phase=0),
    dict(f=38.7, scale=1, phase=0),
    dict(f=39.4, scale=1, phase=0),
    dict(f=40.5, scale=1, phase=0)
]

def alpha_func(t):
    return sum(m['scale'] * np.cos(2 * np.pi * m['f'] * t + m['phase'])
               for m in modes)

# Grid must span the worst-case excursion of alpha
alpha_max = sum(abs(m['scale']) for m in modes)

# ── Gravitational potential of a single cylinder ──────────────────────────────
def cylinder_potential(x, y, z, cx, cy, cz, M, R, H, axis='z'):
    rho_vol = M / (np.pi * R**2 * H)
    def integrand(zp, rp, theta):
        local = np.array([rp * np.cos(theta), rp * np.sin(theta), zp])
        if   axis == 'z': dx, dy, dz = local[0], local[1], local[2]
        elif axis == 'x': dx, dy, dz = local[2], local[0], local[1]
        elif axis == 'y': dx, dy, dz = local[1], local[2], local[0]
        r = np.sqrt((x - cx - dx)**2 + (y - cy - dy)**2 + (z - cz - dz)**2)
        return -G * rho_vol * rp / r if r > 0 else 0.0
    result, _ = integrate.nquad(
        integrand,
        [[-H/2, H/2], [0, R], [0, 2*np.pi]],
        opts={'limit': 50}
    )
    return result


def scaffold_potential_mode(x, y, z, alpha, members, amplitudes):
    V = 0.0
    for m, A_i in zip(members, amplitudes):
        V += cylinder_potential(
            x, y, z,
            m['dx'] + A_i * alpha,
            m['dy'], m['dz'],
            m['M'], m['R'], m['H'], m['axis']
        )
    return V


# ── Atom trajectories ─────────────────────────────────────────────────────────
def atom_path(z_0, u, t_start, t_end, delta_t, acc, floor):
    timesteps = np.arange(t_start, t_end, delta_t)
    z, v = z_0, u
    z_positions = []
    for _ in timesteps:
        z += v * delta_t + 0.5 * acc * delta_t**2
        v += acc * delta_t
        if z <= floor and v < 0:
            z = floor; v = 0.0; break
        z_positions.append(z)
    return timesteps[:len(z_positions)], np.array(z_positions), v

def lower_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] + velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

def upper_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u + velocity_boost, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] - velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

# ── Build trajectories ────────────────────────────────────────────────────────
N  = 50_000
dt = 0.01
timestep = np.arange(0, N * 2, dt)

lower1 = np.concatenate([lower_arm(0, u_initial, 0, T, dt, -g, 0)[1] for _ in range(N)])
lower2 = np.concatenate([lower_arm(5, u_initial, 0, T, dt, -g, 5)[1] for _ in range(N)])
upper1 = np.concatenate([upper_arm(0, u_initial, 0, T, dt, -g, 0)[1] for _ in range(N)])
upper2 = np.concatenate([upper_arm(5, u_initial, 0, T, dt, -g, 5)[1] for _ in range(N)])

t_full    = timestep[:len(lower1)]
interp_l1 = interp1d(t_full, lower1, bounds_error=False, fill_value=(lower1[0], lower1[-1]))
interp_u1 = interp1d(t_full, upper1, bounds_error=False, fill_value=(upper1[0], upper1[-1]))
interp_l2 = interp1d(t_full, lower2, bounds_error=False, fill_value=(lower2[0], lower2[-1]))
interp_u2 = interp1d(t_full, upper2, bounds_error=False, fill_value=(upper2[0], upper2[-1]))

x, y = 0.0, 0.0

print(f"\nAtom trajectories:")
print(f"  IFO 1 upper arm max height: {upper1.max():.2f} m")
print(f"  IFO 2 upper arm max height: {upper2.max():.2f} m")

# ── Potential grid ────────────────────────────────────────────────────────────
n_zgrid    = 30
n_alpha    = 12
z_min_phys = 0.0
z_max_phys = max(upper1.max(), upper2.max()) + 0.5
z_grid     = np.linspace(z_min_phys, z_max_phys, n_zgrid)
alpha_grid = np.linspace(-alpha_max, alpha_max, n_alpha)

print(f"\nModes:")
for m in modes:
    print(f"  f={m['f']} Hz, scale={m['scale']}, phase={m['phase']:.2f} rad")
print(f"alpha range: [{-alpha_max:.2f}, {alpha_max:.2f}]")
print(f"\nPrecomputing potential grid ({n_alpha} x {n_zgrid} = {n_alpha*n_zgrid} points,"
      f" {len(members)} members each) ...")

V_grid = np.zeros((n_alpha, n_zgrid))
for i, alpha in enumerate(alpha_grid):
    for j, zj in enumerate(z_grid):
        V_grid[i, j] = scaffold_potential_mode(x, y, zj, alpha, members, amplitudes)
    print(f"  alpha row {i+1}/{n_alpha} done", flush=True)

V_interp = RectBivariateSpline(alpha_grid, z_grid, V_grid)

# ── Phase difference ──────────────────────────────────────────────────────────
subsample_times = np.arange(2*T, timestep.max(), 2)

print(f"\nComputing phase differences ({len(subsample_times)} measurements) ...")
dp1 = np.empty(len(subsample_times))
dp2 = np.empty(len(subsample_times))

for k, t_c in enumerate(subsample_times):
    def ig1(t):
        a = alpha_func(t)
        return float(V_interp(a, float(interp_u1(t)), grid=False)
                    - V_interp(a, float(interp_l1(t)), grid=False))
    def ig2(t):
        a = alpha_func(t)
        return float(V_interp(a, float(interp_u2(t)), grid=False)
                    - V_interp(a, float(interp_l2(t)), grid=False))
    p1, _ = quad(ig1, t_c - 2*T, t_c, limit=100)
    p2, _ = quad(ig2, t_c - 2*T, t_c, limit=100)
    dp1[k] = (m_atom / hbar) * p1
    dp2[k] = (m_atom / hbar) * p2

phase_diff = dp1 - dp2
pd_ac      = phase_diff - phase_diff.mean()
max_pd     = np.max(np.abs(pd_ac))
print(f"  Max |ΔΦ| (AC) = {max_pd*1e6:.4f} µrad")

# ── PSD ───────────────────────────────────────────────────────────────────────
delta_t = 2.0
N_meas  = len(phase_diff)
S_k     = (delta_t / N_meas) * np.abs(np.fft.rfft(pd_ac))**2
f_k     = np.fft.rfftfreq(N_meas, d=delta_t)

# ── Figures ───────────────────────────────────────────────────────────────────
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 10), tight_layout=True)

ax1.plot(subsample_times, pd_ac * 1e6, 'o-', color='firebrick')
ax1.set_xlabel('$t$ [s]', fontsize=16)
ax1.set_ylabel(r'$\Delta\Phi$ [µrad]', fontsize=16)

ax2.plot(f_k[1:], np.sqrt(S_k[1:]) * 1e6, color='seagreen')
ax2.set_xlabel('$f$ [Hz]', fontsize=16)
ax2.set_ylabel(r'$\sqrt{S}$ [µrad / $\sqrt{\rm Hz}$]', fontsize=16)
ax2.set_xlim(0, 0.5 / delta_t)

plt.show()
print("\nDone.")
