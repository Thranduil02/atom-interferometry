# -*- coding: utf-8 -*-
"""
Scaffold GGN simulation — multiple simultaneous oscillation modes.

Each mode shares the same linear amplitude profile (A_bottom at z=0,
A_top at z=H_total) but has its own frequency and scale factor.
The total x-displacement of member i at time t is:

    x_i(t) = A_i * alpha(t),   alpha(t) = Σ_m scale_m * cos(2π f_m t + phase_m)

Because alpha is still a scalar, the same single V(alpha, z) grid
from scaffold works exactly — only alpha_func and its range change.
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy import integrate
from scipy.integrate import quad
from scipy.interpolate import RectBivariateSpline, interp1d

# ── Constants ─────────────────────────────────────────────────────────────────
G              = 6.67430e-11
u_initial      = 3.86
m_atom         = 1.46e-25
hbar           = 1.055e-34
wavelength     = 698e-9
wavenumber     = 2 * np.pi / wavelength
T              = 0.73
n_kicks        = 1000
velocity_boost = n_kicks * hbar * wavenumber / m_atom
g              = 9.81

# ── Steel scaffold parameters ─────────────────────────────────────────────────
rho_steel = 7850.0
R_edge    = 0.0338
L_cube    = 1.0
N_cubes   = 10
H_total   = N_cubes * L_cube   # 10 m

M_edge = rho_steel * np.pi * R_edge**2 * L_cube
print(f"Steel edge: R={R_edge*1000:.0f} mm, L={L_cube:.1f} m, M_edge={M_edge:.2f} kg")

# ── Build scaffold member list ────────────────────────────────────────────────
h = L_cube / 2.0

members = []

H_col = N_cubes * L_cube
M_col = rho_steel * np.pi * R_edge**2 * H_col
for sy in (-1, 1):
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': sy * h, 'dz': H_col / 2.0,
            'M': M_col, 'R': R_edge, 'H': H_col, 'axis': 'z'
        })

for k in range(N_cubes + 1):
    z_ring = k * L_cube
    for sy in (-1, 1):
        members.append({
            'dx': 0.0, 'dy': sy * h, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'x'
        })
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': 0.0, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'y'
        })

total_mass = sum(m['M'] for m in members)
print(f"Tower: {len(members)} members, total mass = {total_mass:.1f} kg")

# ── Per-member oscillation amplitude (linear in z) ───────────────────────────
A_bottom = 1e-6   # 1 µm  at z = 0
A_top    = 1e-4   # 1 mm  at z = H_total

amplitudes = np.array([
    A_bottom + (A_top - A_bottom) * m['dz'] / H_total
    for m in members
])

# ── Oscillation modes ─────────────────────────────────────────────────────────
# Each mode: frequency [Hz], scale (multiplies the base amplitude profile),
# and an optional phase offset [rad].
modes = [
    dict(f=2.30, scale=1.0,  phase=0.0),
    dict(f=2.34,  scale=1,  phase=0.0),
    dict(f=12.7, scale=1,  phase=0.0),
    dict(f=35.1, scale=1, phase=0),
    dict(f=37.0, scale=1, phase=0),
    dict(f=38.7, scale=1, phase=0),
    dict(f=39.4, scale=1, phase=0),
    dict(f=40.5, scale=1, phase=0)
]

def alpha_func(t):
    return sum(m['scale'] * np.cos(2 * np.pi * m['f'] * t + m['phase'])
               for m in modes)

# Grid must span the worst-case excursion of alpha
alpha_max = sum(abs(m['scale']) for m in modes)

# ── Gravitational potential of a single cylinder ──────────────────────────────
def cylinder_potential(x, y, z, cx, cy, cz, M, R, H, axis='z'):
    rho_vol = M / (np.pi * R**2 * H)
    def integrand(zp, rp, theta):
        local = np.array([rp * np.cos(theta), rp * np.sin(theta), zp])
        if   axis == 'z': dx, dy, dz = local[0], local[1], local[2]
        elif axis == 'x': dx, dy, dz = local[2], local[0], local[1]
        elif axis == 'y': dx, dy, dz = local[1], local[2], local[0]
        r = np.sqrt((x - cx - dx)**2 + (y - cy - dy)**2 + (z - cz - dz)**2)
        return -G * rho_vol * rp / r if r > 0 else 0.0
    result, _ = integrate.nquad(
        integrand,
        [[-H/2, H/2], [0, R], [0, 2*np.pi]],
        opts={'limit': 50}
    )
    return result


def scaffold_potential_mode(x, y, z, alpha, members, amplitudes):
    V = 0.0
    for m, A_i in zip(members, amplitudes):
        V += cylinder_potential(
            x, y, z,
            m['dx'] + A_i * alpha,
            m['dy'], m['dz'],
            m['M'], m['R'], m['H'], m['axis']
        )
    return V


# ── Atom trajectories ─────────────────────────────────────────────────────────
def atom_path(z_0, u, t_start, t_end, delta_t, acc, floor):
    timesteps = np.arange(t_start, t_end, delta_t)
    z, v = z_0, u
    z_positions = []
    for _ in timesteps:
        z += v * delta_t + 0.5 * acc * delta_t**2
        v += acc * delta_t
        if z <= floor and v < 0:
            z = floor; v = 0.0; break
        z_positions.append(z)
    return timesteps[:len(z_positions)], np.array(z_positions), v

def lower_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] + velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

def upper_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u + velocity_boost, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] - velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

# ── Build trajectories ────────────────────────────────────────────────────────
T_total  = 3e6   # total simulated observation time [s]
T_cycle  = 2.0          # duration of one launch/measurement cycle [s] (also the
                        # subsampling spacing used below, and lower_arm/upper_arm's
                        # default total_time)
dt       = 0.01
N        = int(round(T_total / T_cycle))
timestep = np.arange(0, N * T_cycle, dt)

lower1 = np.concatenate([lower_arm(0, u_initial, 0, T, dt, -g, 0, total_time=T_cycle)[1] for _ in range(N)])
lower2 = np.concatenate([lower_arm(5, u_initial, 0, T, dt, -g, 5, total_time=T_cycle)[1] for _ in range(N)])
upper1 = np.concatenate([upper_arm(0, u_initial, 0, T, dt, -g, 0, total_time=T_cycle)[1] for _ in range(N)])
upper2 = np.concatenate([upper_arm(5, u_initial, 0, T, dt, -g, 5, total_time=T_cycle)[1] for _ in range(N)])

t_full    = timestep[:len(lower1)]
interp_l1 = interp1d(t_full, lower1, bounds_error=False, fill_value=(lower1[0], lower1[-1]))
interp_u1 = interp1d(t_full, upper1, bounds_error=False, fill_value=(upper1[0], upper1[-1]))
interp_l2 = interp1d(t_full, lower2, bounds_error=False, fill_value=(lower2[0], lower2[-1]))
interp_u2 = interp1d(t_full, upper2, bounds_error=False, fill_value=(upper2[0], upper2[-1]))

x, y = 0.0, 0.0

print(f"\nAtom trajectories:")
print(f"  IFO 1 upper arm max height: {upper1.max():.2f} m")
print(f"  IFO 2 upper arm max height: {upper2.max():.2f} m")

# ── Potential grid ────────────────────────────────────────────────────────────
n_zgrid    = 30
n_alpha    = 12
z_min_phys = 0.0
z_max_phys = max(upper1.max(), upper2.max()) + 0.5
z_grid     = np.linspace(z_min_phys, z_max_phys, n_zgrid)
alpha_grid = np.linspace(-alpha_max, alpha_max, n_alpha)

print(f"\nModes:")
for m in modes:
    print(f"  f={m['f']} Hz, scale={m['scale']}, phase={m['phase']:.2f} rad")
print(f"alpha range: [{-alpha_max:.2f}, {alpha_max:.2f}]")
print(f"\nPrecomputing potential grid ({n_alpha} x {n_zgrid} = {n_alpha*n_zgrid} points,"
      f" {len(members)} members each) ...")

V_grid = np.zeros((n_alpha, n_zgrid))
for i, alpha in enumerate(alpha_grid):
    for j, zj in enumerate(z_grid):
        V_grid[i, j] = scaffold_potential_mode(x, y, zj, alpha, members, amplitudes)
    print(f"  alpha row {i+1}/{n_alpha} done", flush=True)

V_interp = RectBivariateSpline(alpha_grid, z_grid, V_grid)

# ── Phase difference ──────────────────────────────────────────────────────────
subsample_times = np.arange(2*T, timestep.max(), T_cycle)

print(f"\nComputing phase differences ({len(subsample_times)} measurements) ...")
dp1 = np.empty(len(subsample_times))
dp2 = np.empty(len(subsample_times))

for k, t_c in enumerate(subsample_times):
    def ig1(t):
        a = alpha_func(t)
        return float(V_interp(a, float(interp_u1(t)), grid=False)
                    - V_interp(a, float(interp_l1(t)), grid=False))
    def ig2(t):
        a = alpha_func(t)
        return float(V_interp(a, float(interp_u2(t)), grid=False)
                    - V_interp(a, float(interp_l2(t)), grid=False))
    p1, _ = quad(ig1, t_c - 2*T, t_c, limit=100)
    p2, _ = quad(ig2, t_c - 2*T, t_c, limit=100)
    dp1[k] = (m_atom / hbar) * p1
    dp2[k] = (m_atom / hbar) * p2

phase_diff_raw = dp1 - dp2
pd_ac          = phase_diff_raw - phase_diff_raw.mean()   # AC phase used in every top panel
max_pd         = np.max(np.abs(pd_ac))
print(f"  Max |ΔΦ| (AC) = {max_pd*1e6:.4f} µrad")

# ── ULDM tone (verbatim model from fig2_final.py, this scaffold's own geometry) ─
delta_r     = 5.0     # gradiometer baseline: IFO2 sits 5 m above IFO1
T_fly       = 2 * T   # full interferometer flight time
f_phi       = 0.05    # ULDM Compton frequency [Hz]
hbar_eV     = 6.582119569e-16                 # hbar in eV*s
m_phi       = 2 * np.pi * f_phi * hbar_eV     # Compton relation
G_nat       = 6.708e-39
d_e         = 1e-3;  d_m_e      = 1e-3
rho_phi     = 0.3
uldm_theta  = np.pi / 2;  xi  = 0.06
omega_A     = 2.67e15
L_base      = 140.0
n_lmt       = n_kicks;  conv_factor = 2.77e-12
c_light     = 3e8

def uldm_phase_vec(t, f_uldm, m_phi_val):
    delta_omega_A = (omega_A * np.sqrt(G_nat * 4 * np.pi)
                     * (d_m_e + (2 + xi) * d_e)
                     * (np.sqrt(2 * rho_phi) / m_phi_val)
                     * conv_factor)
    omega_phi = 2 * np.pi * f_uldm
    return (8 * (delta_omega_A / omega_phi) * (delta_r / L_base)
            * np.sin(omega_phi * n_lmt * L_base / (2 * c_light))
            * np.sin(omega_phi * (T - (n_lmt - 1) * L_base / c_light) / 2)
            * np.cos(omega_phi * ((T_fly + L_base / c_light) / 2 + t) + uldm_theta))

uldm             = uldm_phase_vec(subsample_times, f_phi, m_phi)
phase_diff_uldm  = phase_diff_raw + uldm

# ── PSD helpers ───────────────────────────────────────────────────────────────
delta_t = T_cycle
N_meas  = len(phase_diff_raw)
f_N     = 0.5 / delta_t

def periodogram(ph):
    f_k  = np.fft.rfftfreq(N_meas, d=delta_t)
    S_k  = (delta_t / N_meas) * np.abs(np.fft.rfft(ph - ph.mean()))**2
    mask = f_k > 0
    return f_k[mask], S_k[mask]

def add_noise(ph, shot_noise_asd):
    return ph + np.random.normal(0.0, shot_noise_asd / np.sqrt(delta_t), size=len(ph))

def fold_frequency(f, fN):
    fs = 2 * fN
    r = f % fs
    return fs - r if r > fN else r

def peak_at(f_k, S_urad, f_target):
    idx = np.argmin(np.abs(f_k - f_target))
    return f_k[idx], S_urad[idx]

f_k, S_k_raw  = periodogram(phase_diff_raw)
_,   S_k_uldm = periodogram(phase_diff_uldm)
urad_raw      = np.sqrt(S_k_raw) * 1e6
urad_uldm     = np.sqrt(S_k_uldm) * 1e6

# ── Noise floor (house style from fig2_circle_summary.py, stretch level only) ──
NOISE_LEVELS = [
    dict(key='stretch', asd=1e-5, label='stretch (1e-5)', color='#1b5e20', lw=0.5, zorder=3),
]
urad_noise = {}
for lvl in NOISE_LEVELS:
    _, S = periodogram(add_noise(phase_diff_uldm, lvl['asd']))
    urad_noise[lvl['key']] = np.sqrt(S) * 1e6
urad_noise_marker = urad_noise['stretch']

# ── colour-by-physical-origin palette (verbatim from fig2_final.py) ─────────────
COLORS = dict(
    uldm        = '#1f4e9c',   # blue  -- f_phi (ULDM signal), always
    fundamental = '#c1272d',   # red   -- scaffold vibration modes, always
)

f_phi_bin, f_phi_peak_uldm  = peak_at(f_k, urad_uldm, f_phi)
_,         f_phi_peak_noise = peak_at(f_k, urad_noise_marker, f_phi)
print(f"\nULDM peak at f_phi = {f_phi} Hz: {f_phi_peak_uldm:.4g} urad/rtHz (bin {f_phi_bin:.4f} Hz)")

def mode_rows_for(urad):
    rows = []
    for m in modes:
        f_fold = fold_frequency(m['f'], f_N)
        f_bin, peak = peak_at(f_k, urad, f_fold)
        rows.append(dict(f0=m['f'], f_bin=f_bin, peak=peak, folded=m['f'] > f_N))
    return rows

rows_raw   = mode_rows_for(urad_raw)
rows_uldm  = mode_rows_for(urad_uldm)
rows_noise = mode_rows_for(urad_noise_marker)

print(f"\nScaffold vibration modes (folded to [0, {f_N:g}] Hz baseband):")
for m, row in zip(modes, rows_raw):
    status = 'genuine (< f_N)' if m['f'] <= f_N else 'folded/aliased'
    print(f"  f0={m['f']:>6.2f} Hz  ->  folded bin {row['f_bin']:>6.4f} Hz  "
          f"peak={row['peak']:>10.4g} urad/rtHz  {status}")

# ── Shared plotting helpers ──────────────────────────────────────────────────
def plot_phase_panel(ax):
    mask_100s = subsample_times <= 100
    ax.plot(subsample_times[mask_100s], pd_ac[mask_100s] * 1e6, 'o', color='blue')
    ax.set_xlabel('$t$ [s]', fontsize=16)
    ax.set_ylabel(r'$\Delta\Phi$ [µrad]', fontsize=16)

def mark_uldm(ax, y_min, f_bin, peak):
    ax.vlines(f_bin, y_min, peak, color=COLORS['uldm'], lw=0.8, zorder=4)
    ax.scatter([f_bin], [peak], color=COLORS['uldm'], zorder=5, s=40, marker='D')
    ax.annotate(r'$f_\varphi$', (f_bin, peak), textcoords='offset points',
                xytext=(6, 6), fontsize=9, color=COLORS['uldm'])

def mark_modes(ax, y_min, rows):
    # several modes can alias onto the same folded bin -- group them so a
    # shared circle gets one combined label instead of overlapping duplicates
    groups = {}
    for row in rows:
        groups.setdefault(row['f_bin'], []).append(row)
    for f_bin, group in groups.items():
        peak = group[0]['peak']
        ax.vlines(f_bin, y_min, peak, color=COLORS['fundamental'], lw=0.8, zorder=4)
        ax.scatter([f_bin], [peak], color=COLORS['fundamental'], zorder=5, s=30)
        label = ', '.join(f"{row['f0']:g}" + (' (folded)' if row['folded'] else '') for row in group) + ' Hz'
        ax.annotate(label, (f_bin, peak), textcoords='offset points',
                    xytext=(4, 6), fontsize=6, color=COLORS['fundamental'], rotation=90)

def finish_periodogram_axes(ax, y_min, y_max):
    ax.set_yscale('log')
    ax.set_xlim(0, f_N)
    ax.set_ylim(y_min, y_max)
    ax.axvline(f_N, color='k', ls='--', lw=0.5, alpha=0.6)
    ax.text(f_N, y_max * 0.5, r'  $f_N$', fontsize=8, ha='left', va='center')
    ax.set_xlabel('$f$ [Hz]', fontsize=16)
    ax.set_ylabel(r'$\sqrt{S}$ [µrad / $\sqrt{\rm Hz}$]', fontsize=16)

# ── Figure 1: just scaffold ──────────────────────────────────────────────────
fig1, (ax1a, ax1b) = plt.subplots(2, 1, figsize=(10, 15), tight_layout=True)
plot_phase_panel(ax1a)

y_min1 = 0.1 * urad_raw[urad_raw > 0].min()
y_max1 = 3 * urad_raw.max()
ax1b.plot(f_k, urad_raw, color='firebrick', lw=0.6, zorder=2, label='scaffold')
mark_modes(ax1b, y_min1, rows_raw)
finish_periodogram_axes(ax1b, y_min1, y_max1)
ax1b.legend(handles=[
    plt.Line2D([], [], color='firebrick', lw=1.5, label='scaffold'),
], fontsize=8, loc='upper right', frameon=False)
fig1.savefig(r'C:\Users\Georg\Desktop\scaffold_phasediff.png', dpi=200)

# ── Figure 2: scaffold + ULDM ────────────────────────────────────────────────
fig2, (ax2a, ax2b) = plt.subplots(2, 1, figsize=(10, 15), tight_layout=True)
plot_phase_panel(ax2a)

y_min2 = 0.1 * min(urad_uldm[urad_uldm > 0].min(), f_phi_peak_uldm)
y_max2 = 3 * max(urad_uldm.max(), f_phi_peak_uldm)
ax2b.plot(f_k, urad_uldm, color='#555555', lw=0.6, zorder=2, label='scaffold + ULDM')
mark_uldm(ax2b, y_min2, f_phi_bin, f_phi_peak_uldm)
mark_modes(ax2b, y_min2, rows_uldm)
finish_periodogram_axes(ax2b, y_min2, y_max2)
ax2b.legend(handles=[
    plt.Line2D([], [], color='#555555', lw=1.5, label='scaffold + ULDM'),
    plt.Line2D([], [], color=COLORS['uldm'], marker='D', ls='', label=r'ULDM tone $f_\varphi$'),
], fontsize=8, loc='upper right', frameon=False)
fig2.savefig(r'C:\Users\Georg\Desktop\scaffold_phasediff_uldm.png', dpi=200)

# ── Figure 3: scaffold + ULDM + noise floors ─────────────────────────────────
fig3, (ax3a, ax3b) = plt.subplots(2, 1, figsize=(10, 15), tight_layout=True)
plot_phase_panel(ax3a)

y_min3 = 0.1 * min(lvl['asd'] for lvl in NOISE_LEVELS) * 1e6
y_max3 = 3 * max(urad_noise['stretch'].max(), f_phi_peak_noise)
for lvl in NOISE_LEVELS:
    ax3b.plot(f_k, urad_noise[lvl['key']], color=lvl['color'], lw=lvl['lw'], zorder=lvl['zorder'])
mark_uldm(ax3b, y_min3, f_phi_bin, f_phi_peak_noise)
mark_modes(ax3b, y_min3, rows_noise)
finish_periodogram_axes(ax3b, y_min3, y_max3)
ax3b.legend(handles=[
    plt.Line2D([], [], color=lvl['color'], lw=2.5, label=lvl['label']) for lvl in NOISE_LEVELS
] + [
    plt.Line2D([], [], color=COLORS['uldm'], marker='D', ls='', label=r'ULDM tone $f_\varphi$'),
], fontsize=8, loc='upper right', frameon=False)
fig3.savefig(r'C:\Users\Georg\Desktop\scaffold_phasediff_uldm_noise.png', dpi=200)

plt.show()
print("\nDone.")
