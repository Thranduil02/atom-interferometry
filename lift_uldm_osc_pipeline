"""
Lift excision and Lomb-Scargle recovery.

A 1D oscillator at f_sig = 0.1 Hz provides the GGN signal.
A 1000 kg lift mass at D_lift = 10 m travels from h = -10 to h = 20 m
at v = 1 m/s several times during the data stream.

The lift introduces large-amplitude transients in the phase data.
Contaminated cycles are identified, excised, and the remaining
data is analysed with Lomb-Scargle to recover f_sig.
"""

import numpy as np
import matplotlib.pyplot as plt

# ── user-editable parameters ───────────────────────────────────────────────────
T_total          = 6000    # s – total observation time
lift_mean_period = 300    # s – average time between lift events (5 minutes)
lift_pad         = 10.0   # s – padding added either side of each lift window
rng_seed         = 42

# ── constants ──────────────────────────────────────────────────────────────────
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11;  g = 9.81
# oscillator GGN source
M_osc = 1;  h_0 = 1;  D_0 = 5;  A = 1;  f_sig = 0.12
# lift parameters
M_lift = 1000;  D_lift = 10
h_lift_lo = -10;  h_lift_hi = 20;  v_lift = 1.0
lift_duration = (h_lift_hi - h_lift_lo) / v_lift   # 30 s

u0 = 3.86;  dt = 0.01;  T = 0.73;  T_cyc = 2.0

# ── trajectory helpers ─────────────────────────────────────────────────────────
def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_cycle(z0, floor, upper=False):
    Nc = int(T_cyc / dt)
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0 + k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _  = atom_path(p1[-1] if len(p1) else float(floor),
                        v1 + k2, T, 2*T, floor)
    path = np.concatenate([p1, p2])
    Nc_ = int(T_cyc / dt)
    if len(path) < Nc_:
        path = np.concatenate([path, np.full(Nc_ - len(path), float(floor))])
    return path[:Nc_]

def V_osc(z, h):
    return -G * M_osc / np.sqrt(D_0**2    + (z - h)**2)

def V_lift(z, h):
    return -G * M_lift / np.sqrt(D_lift**2 + (z - h)**2)

# ── ULDM parameters ───────────────────────────────────────────────────────────
G_nat       = 6.708e-39   # Newton's constant in GeV^-2 (natural units)
d_e         = 1
d_m_e       = 1
m_phi       = 4e-16       # eV, ULDM mass
rho_phi     = 0.3         # GeV/cm^3, local DM density
f_uldm      = 0.1         # Hz, ULDM oscillation frequency
theta       = np.pi / 2   # initial phase
xi          = 0.06        # strontium-86 clock transition parameter
omega_A     = 2.67e15     # rad/s, atom transition frequency
L_base      = 10          # m, interferometer baseline
delta_r     = 5           # m, gradiometer separation
n_lmt       = 1000        # LMT kick number
conv_factor = 2.77e-12    # unit conversion natural units → SI

def uldm_phase(t_meas_cycle):
    """ULDM gradiometer phase for a cycle with measurement time t_meas_cycle."""
    delta_omega_A = (omega_A * np.sqrt(G_nat * 4 * np.pi)
                     * (d_m_e + (2 + xi) * d_e)
                     * (np.sqrt(2 * rho_phi) / m_phi)
                     * conv_factor)
    omega_phi = 2 * np.pi * f_uldm
    return (8 * (delta_omega_A / omega_phi) * (delta_r / L_base)
            * np.sin(omega_phi * n_lmt * L_base / (2 * 3e8))
            * np.sin(omega_phi * (T - (n_lmt - 1) * L_base / 3e8) / 2)
            * np.sin(omega_phi * T / 2)
            * np.cos(omega_phi * ((2*T + L_base/3e8) / 2 + t_meas_cycle) + theta))

# ── pre-compute arm positions ──────────────────────────────────────────────────
L       = int(round(2 * T / dt))   # integration steps per cycle
t_local = np.arange(L) * dt        # local time grid [0, 2T)

lower1 = arm_cycle(0, 0, upper=False)[:L]
upper1 = arm_cycle(0, 0, upper=True )[:L]
lower2 = arm_cycle(5, 5, upper=False)[:L]
upper2 = arm_cycle(5, 5, upper=True )[:L]

# ── random lift start times (Poisson process, ~once per lift_mean_period) ─────
rng = np.random.default_rng(rng_seed)

lift_starts = []
t_next = rng.exponential(lift_mean_period)
while t_next + lift_duration < T_total - 20:
    if t_next > 20:
        lift_starts.append(t_next)
    t_next += lift_duration + rng.exponential(lift_mean_period)
lift_starts = np.array(lift_starts)
n_lift_events = len(lift_starts)

print(f"Lift start times: {np.round(lift_starts, 1)} s")
print(f"Lift duration:    {lift_duration:.0f} s per transit")

# ── compute phases cycle by cycle ─────────────────────────────────────────────
N_cyc     = int(T_total / T_cyc)
phases    = np.zeros(N_cyc)
t_meas    = np.zeros(N_cyc)
lift_mask = np.zeros(N_cyc, dtype=bool)

for k in range(N_cyc):
    t_start = k * T_cyc
    t_abs   = t_start + t_local   # absolute times during integration window

    # oscillator GGN
    h_osc = h_0 + A * np.cos(2*np.pi * f_sig * t_abs)
    dphi  = (V_osc(upper1, h_osc) - V_osc(lower1, h_osc)) \
          - (V_osc(upper2, h_osc) - V_osc(lower2, h_osc))

    # lift contribution
    for t_lift in lift_starts:
        t_lift_end = t_lift + lift_duration
        win_end    = t_start + 2*T
        if t_lift_end > t_start and t_lift < win_end:
            h_l    = np.clip(h_lift_lo + v_lift * (t_abs - t_lift),
                             h_lift_lo, h_lift_hi)
            active = (t_abs >= t_lift) & (t_abs <= t_lift_end)
            dl = np.zeros(L)
            dl[active] = (
                (V_lift(upper1[active], h_l[active]) - V_lift(lower1[active], h_l[active])) -
                (V_lift(upper2[active], h_l[active]) - V_lift(lower2[active], h_l[active]))
            )
            dphi += dl

    phases[k] = (m_atom / hbar) * np.trapezoid(dphi, t_abs) + uldm_phase(t_start + 2*T)
    t_meas[k] = t_start + 2*T

# ── excise contaminated cycles using t_meas directly ──────────────────────────
for t_lift in lift_starts:
    t_lift_end = t_lift + lift_duration
    lift_mask |= (t_meas >= t_lift - lift_pad) & (t_meas <= t_lift_end + lift_pad)

# ── excise contaminated cycles ─────────────────────────────────────────────────
t_clean = t_meas[~lift_mask]
y_clean = phases[~lift_mask]
N_clean = len(t_clean)

print(f"\nTotal cycles:       {N_cyc}")
print(f"Contaminated:       {lift_mask.sum()}")
print(f"Retained:           {N_clean}")

# ── FFT of full data ───────────────────────────────────────────────────────────
f_fft    = np.fft.rfftfreq(N_cyc, d=T_cyc)
S_fft    = (T_cyc / N_cyc) * np.abs(np.fft.rfft(phases - phases.mean()))**2
mask_fft = f_fft > 0

# ── LS on cleaned data ─────────────────────────────────────────────────────────
def ls_psd(t, y, freqs, return_coeffs=False):
    y = y - y.mean()
    dt_eff = (t[-1] - t[0]) / (len(t) - 1)
    w  = 2 * np.pi * freqs
    wt = np.outer(w, t)
    tau = np.arctan2(np.sin(2*wt).sum(1), np.cos(2*wt).sum(1)) / (2 * w)
    sh  = wt - (w * tau)[:, None]
    ct  = np.cos(sh);  st = np.sin(sh)
    C   = ct @ y;      S  = st @ y
    CC  = (ct**2).sum(1);  SS = (st**2).sum(1)
    psd = dt_eff * 0.5 * (C**2 / CC + S**2 / SS)
    if return_coeffs:
        return psd, C / CC, S / SS
    return psd

f_grid = np.linspace(1/T_total, 0.49/T_cyc, 6000)
S_ls   = ls_psd(t_clean, y_clean, f_grid)

# ── Stage 2: least-squares notch at f_sig ─────────────────────────────────────
omega_sig = 2 * np.pi * f_sig
A_notch   = np.column_stack([np.cos(omega_sig * t_clean),
                              np.sin(omega_sig * t_clean)])
coeffs, _, _, _ = np.linalg.lstsq(A_notch, y_clean, rcond=None)
y_notched = y_clean - A_notch @ coeffs

# ── Stage 3: LS on notched residuals ──────────────────────────────────────────
S_ls_notched = ls_psd(t_clean, y_notched, f_grid)

# ── true ULDM signal on a fine time grid ──────────────────────────────────────
t_fine = np.linspace(t_clean[0], t_clean[-1], 5000)
y_true = uldm_phase(t_fine)

# ── plots ──────────────────────────────────────────────────────────────────────

# Figure 1: motivation — full data time series + FFT
fig1, (ax_t, ax_f) = plt.subplots(2, 1, figsize=(14, 8))

ax_t.plot(t_meas, phases * 1e6, color='steelblue', lw=0.8, zorder=2)
for i, t_lift in enumerate(lift_starts):
    ax_t.axvspan(t_lift - lift_pad, t_lift + lift_duration + lift_pad,
                 alpha=0.25, color='firebrick',
                 label='Lift active (+ padding)' if i == 0 else '')
ax_t.set_xlabel('$t$ [s]', fontsize=14)
ax_t.set_ylabel(r'$\Delta\Phi$ [$\mu$rad]', fontsize=14)
ax_t.set_title('Before pipeline: full data — phase time series', fontsize=14)
ax_t.legend(fontsize=12)
ax_t.tick_params(labelsize=11)

ax_f.plot(f_fft[mask_fft], np.sqrt(S_fft[mask_fft]), color='steelblue', lw=1.2)
ax_f.axvline(f_sig,  ls='--', color='k',        lw=1.2, label=rf'$f_\mathrm{{GGN}} = {f_sig}$ Hz')
ax_f.axvline(f_uldm, ls='--', color='seagreen', lw=1.2, label=rf'$f_\mathrm{{ULDM}} = {f_uldm}$ Hz')
ax_f.set_xlabel('$f$ [Hz]', fontsize=14)
ax_f.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=14)
ax_f.set_title('Before pipeline: full data — FFT (lift-contaminated)', fontsize=14)
ax_f.legend(fontsize=12)
ax_f.tick_params(labelsize=11)
fig1.tight_layout()

# Figure 2: Stage 1 — lift excision + LS
fig2, (ax_t2, ax_f2) = plt.subplots(2, 1, figsize=(14, 8))

ax_t2.plot(t_meas,  phases  * 1e6, color='lightgrey', lw=0.8, zorder=1, label='Excised')
t_plot = t_meas.copy().astype(float)
y_plot = phases.copy()
t_plot[lift_mask] = np.nan
y_plot[lift_mask] = np.nan
ax_t2.plot(t_plot, y_plot * 1e6, color='steelblue', lw=0.8, zorder=2, label='Retained')
for t_lift in lift_starts:
    ax_t2.axvspan(t_lift - lift_pad, t_lift + lift_duration + lift_pad,
                  alpha=0.12, color='firebrick')
ax_t2.set_xlabel('$t$ [s]', fontsize=14)
ax_t2.set_ylabel(r'$\Delta\Phi$ [$\mu$rad]', fontsize=14)
ax_t2.set_title('Stage 1: lift excision — phase time series', fontsize=14)
ax_t2.legend(fontsize=12)
ax_t2.tick_params(labelsize=11)

ax_f2.plot(f_grid, np.sqrt(S_ls), color='firebrick', lw=1.2)
ax_f2.axvline(f_sig,  ls='--', color='k',        lw=1.2, label=rf'$f_\mathrm{{GGN}} = {f_sig}$ Hz')
ax_f2.axvline(f_uldm, ls='--', color='seagreen', lw=1.2, label=rf'$f_\mathrm{{ULDM}} = {f_uldm}$ Hz')
ax_f2.set_xlabel('$f$ [Hz]', fontsize=14)
ax_f2.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=14)
ax_f2.set_title('Stage 1: lift excision — Lomb–Scargle', fontsize=14)
ax_f2.legend(fontsize=12)
ax_f2.tick_params(labelsize=11)
fig2.tight_layout()

# Figure 3: Stage 2 — least-squares notch + Stage 3 — ULDM recovery
fig3, (ax_r1, ax_r2) = plt.subplots(2, 1, figsize=(14, 8))

ax_r1.plot(t_clean, y_notched * 1e6, color='seagreen',  lw=0.8, label='Notched residuals')
ax_r1.plot(t_fine,  y_true    * 1e6, color='firebrick', lw=1.5, ls='--', label='True ULDM signal')
ax_r1.set_xlabel('$t$ [s]', fontsize=14)
ax_r1.set_ylabel(r'$\Delta\Phi$ [$\mu$rad]', fontsize=14)
ax_r1.set_title('Stages 2–3: least-squares notch residuals vs true ULDM signal', fontsize=14)
ax_r1.legend(fontsize=11)
ax_r1.tick_params(labelsize=11)

ax_r2.plot(f_grid, np.sqrt(S_ls_notched), color='seagreen', lw=1.2)
ax_r2.axvline(f_uldm, ls='--', color='firebrick', lw=1.5, label=rf'$f_\mathrm{{ULDM}} = {f_uldm}$ Hz')
ax_r2.axvline(f_sig,  ls=':',  color='grey',      lw=1.2, label=rf'$f_\mathrm{{GGN}} = {f_sig}$ Hz (notched)')
ax_r2.set_xlabel('$f$ [Hz]', fontsize=14)
ax_r2.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=14)
ax_r2.set_title('Stage 3: Lomb–Scargle of notched residuals — ULDM recovery', fontsize=14)
ax_r2.legend(fontsize=11)
ax_r2.tick_params(labelsize=11)
fig3.tight_layout()

plt.show()