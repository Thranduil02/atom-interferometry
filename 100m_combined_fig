"""
100 m-class baseline: linear vs circular GGN oscillator, side by side.

Two vertically stacked periodogram panels, both ULDM + shot noise on top of a
single GGN oscillator (A):
  top    - oscillator A oscillating linearly in h only (100m_oscillators)
  bottom - oscillator A tracing a circle of radius amp in the D-h plane
           (100m_circular)

Same trajectories, phase-difference calculation, and sequence as those two
scripts; only the oscillator's motion model differs between panels.
"""

import numpy as np
import matplotlib.pyplot as plt

# ── constants ──────────────────────────────────────────────────────────────────
m_atom  = 1.46e-25;  hbar = 1.055e-34
G       = 6.67e-11;  g    = 9.81
n       = 1000
v_kick  = n * hbar * (2 * np.pi / 698e-9) / m_atom
u0      = 24.5        # launch speed [m/s]
T       = 2.5         # half-interferometry time [s]
T_fly   = 2 * T
T_cyc   = 5.0          # cycle time [s]
dt      = 0.01

N_fly   = int(round(T_fly / dt))
t_local = np.arange(N_fly) * dt

T_total  = 3e7        # total simulation time [s]
N_cycles = int(T_total / T_cyc)

# ── GGN oscillator A (amp is the linear amplitude or the circle radius) ────────
oscillator_A = dict(name='A', f=0.08, amp=0.5, M=0.05, D=3, h0=1.0)

# ── ULDM parameters ────────────────────────────────────────────────────────────
enable_uldm = True
f_uldm      = 0.1
G_nat       = 6.708e-39
d_e         = 1e-3;  d_m_e      = 1e-3
m_phi       = 4e-16;  rho_phi = 0.3
theta       = np.pi / 2;  xi  = 0.06
omega_A     = 2.67e15
L_base      = 140;  delta_r    = 70
n_lmt       = n;  conv_factor = 2.77e-12

def uldm_phase_vec(t):
    delta_omega_A = (omega_A * np.sqrt(G_nat * 4 * np.pi)
                     * (d_m_e + (2 + xi) * d_e)
                     * (np.sqrt(2 * rho_phi) / m_phi)
                     * conv_factor)
    omega_phi = 2 * np.pi * f_uldm
    return (8 * (delta_omega_A / omega_phi) * (delta_r / L_base)
            * np.sin(omega_phi * n_lmt * L_base / (2 * 3e8))
            * np.sin(omega_phi * (T - (n_lmt - 1) * L_base / 3e8) / 2)
            * np.cos(omega_phi * ((T_fly + L_base / 3e8) / 2 + t) + theta))

# ── trajectory helpers ─────────────────────────────────────────────────────────
def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0 + k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _  = atom_path(p1[-1] if len(p1) else float(floor),
                        v1 + k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly - len(path), float(floor))])
    return path[:N_fly]

def V(z, h, M, D):
    return -G * M / np.sqrt(D**2 + (z - h)**2)

# ── pre-compute arm positions (reused for every cycle) ─────────────────────────
lower1 = arm_positions(0, 0, upper=False)
upper1 = arm_positions(0, 0, upper=True)
lower2 = arm_positions(delta_r, delta_r, upper=False)
upper2 = arm_positions(delta_r, delta_r, upper=True)

# ── compute phases ─────────────────────────────────────────────────────────────
t_starts = np.arange(N_cycles) * T_cyc
t_meas   = t_starts + T_fly

def compute_phases(osc, circular, chunk=50_000):
    """Vectorized, chunked over cycles to bound memory at large N_cycles."""
    phases = np.empty(N_cycles)
    for start in range(0, N_cycles, chunk):
        end   = min(start + chunk, N_cycles)
        t_abs = t_starts[start:end][:, None] + t_local[None, :]   # (chunk, N_fly)
        osc_phase = 2 * np.pi * osc['f'] * t_abs
        if circular:
            h_osc = osc['h0'] + osc['amp'] * np.sin(osc_phase)
            D_osc = osc['D'] + osc['amp'] * np.cos(osc_phase)
        else:
            h_osc = osc['h0'] + osc['amp'] * np.cos(osc_phase)
            D_osc = osc['D']
        dphi = ((V(upper1, h_osc, osc['M'], D_osc) - V(lower1, h_osc, osc['M'], D_osc))
              - (V(upper2, h_osc, osc['M'], D_osc) - V(lower2, h_osc, osc['M'], D_osc)))
        phases[start:end] = (m_atom / hbar) * np.trapezoid(dphi, t_local, axis=1)
        print(f"  cycles {end:,}/{N_cycles:,} done", flush=True)
    return phases

def add_uldm_and_noise(phases):
    if enable_uldm:
        phases = phases + uldm_phase_vec(t_meas)
    shot_noise_asd = 1e-4
    phases = phases + np.random.normal(0.0, shot_noise_asd / np.sqrt(T_cyc), size=N_cycles)
    return phases

print(f"Computing {N_cycles:,} cycles (linear oscillator)...")
phases_linear = add_uldm_and_noise(compute_phases(oscillator_A, circular=False))

print(f"Computing {N_cycles:,} cycles (circular oscillator)...")
phases_circular = add_uldm_and_noise(compute_phases(oscillator_A, circular=True))

# ── classical periodogram (FFT) ────────────────────────────────────────────────
def periodogram(ph):
    f_k  = np.fft.rfftfreq(N_cycles, d=T_cyc)
    S_k  = (T_cyc / N_cycles) * np.abs(np.fft.rfft(ph - ph.mean()))**2
    mask = f_k > 0
    return f_k[mask], S_k[mask]

f_linear, S_linear = periodogram(phases_linear)
f_circular, S_circular = periodogram(phases_circular)

# ── plot style ─────────────────────────────────────────────────────────────────
warm_background = False
if warm_background:
    plt.rcParams['figure.facecolor'] = '#fdfcf3'
    plt.rcParams['axes.facecolor']   = '#fdfcf3'

# ── figure: linear oscillator + ULDM (top) vs circular oscillator + ULDM (bottom)
fig, (ax_lin, ax_circ) = plt.subplots(2, 1, figsize=(11, 9), sharex=True)

ax_lin.plot(f_linear, np.sqrt(S_linear), color='firebrick', lw=1.8)
ax_lin.set_ylabel(r'$\sqrt{S_k}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=18)
ax_lin.tick_params(labelsize=13)

ax_circ.plot(f_circular, np.sqrt(S_circular), color='firebrick', lw=1.8)
ax_circ.set_xlabel('$f$ [Hz]', fontsize=18)
ax_circ.set_ylabel(r'$\sqrt{S_k}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=18)
ax_circ.tick_params(labelsize=13)

fig.tight_layout()
fig.savefig(r'C:\Users\Georg\Desktop\oscillators_periodograms_100m_combined.jpg', dpi=200)

plt.show()
