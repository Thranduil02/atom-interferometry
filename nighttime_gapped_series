# -*- coding: utf-8 -*-
"""
One week of data with daily gaps (nighttime shutdown).

Schedule (all times as hours, 24h clock):
  Device ON  from hour_on  to midnight  (e.g. 08:00 – 24:00)
  Device OFF from midnight to hour_on   (e.g. 00:00 – 08:00)
  First day starts at start_hour        (e.g. Monday 09:00)

"""
import numpy as np
import matplotlib.pyplot as plt

# ── adjustable schedule ────────────────────────────────────────────────────────
T_cyc       = 2.0     # cycle time [s]
hour_on     = 8       # daily switch-on hour (24h clock)
hour_off    = 24      # daily switch-off hour (midnight = 24)
start_hour  = 9       # first shot hour on Monday
n_days      = 7       # number of days

# ── physics parameters ─────────────────────────────────────────────────────────
d_e = 1;  d_m_e = 1
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11;  g = 9.81;  M = 1;  h_0 = 1;  D_0 = 5;  A = 1
f_sig = 0.123
u0 = 3.86;  dt = 0.01;  T = 0.73
T_fly = 2*T;  N_fly = int(round(T_fly/dt));  t_local = np.arange(N_fly)*dt

G_nat = 6.708e-39;  m_phi = 4e-16;  rho_phi = 0.3;  f_uldm = 0.1
theta = np.pi/2;  xi = 0.06;  omega_A = 2.67e15
L_base = 10;  delta_r = 5;  n_lmt = 1000;  conv_factor = 2.77e-12

def uldm_phase_vec(t):
    delta_omega_A = (omega_A*np.sqrt(G_nat*4*np.pi)*(d_m_e+(2+xi)*d_e)
                     *(np.sqrt(2*rho_phi)/m_phi)*conv_factor)
    omega_phi = 2*np.pi*f_uldm
    return (8*(delta_omega_A/omega_phi)*(delta_r/L_base)
            *np.sin(omega_phi*n_lmt*L_base/(2*3e8))
            *np.sin(omega_phi*(T-(n_lmt-1)*L_base/3e8)/2)
            *np.sin(omega_phi*T/2)
            *np.cos(omega_phi*((T_fly+L_base/3e8)/2+t)+theta))

def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0+k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _ = atom_path(p1[-1] if len(p1) else float(floor), v1+k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly-len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G*M/np.sqrt(D_0**2+(z-h)**2)

def ls_psd(t, y, freqs, chunk=64):
    y = y - y.mean()
    dt_eff = (t[-1]-t[0])/(len(t)-1)
    out = np.empty(len(freqs))
    for i in range(0, len(freqs), chunk):
        w  = 2*np.pi*freqs[i:i+chunk]
        wt = np.outer(w, t)
        tau = np.arctan2(np.sin(2*wt).sum(1), np.cos(2*wt).sum(1))/(2*w)
        sh  = wt - (w*tau)[:,None]
        ct  = np.cos(sh);  st = np.sin(sh)
        C   = ct@y;  S  = st@y
        CC  = (ct**2).sum(1);  SS = (st**2).sum(1)
        out[i:i+chunk] = dt_eff*0.5*(C**2/CC + S**2/SS)
    return out

# ════════════════════════════════════════════════════════════════════════════════
# Part 1: uniform nighttime — fixed on/off times every day
# ════════════════════════════════════════════════════════════════════════════════
# ── build schedule ─────────────────────────────────────────────────────────────
# t=0 corresponds to Monday start_hour:00
# Convert times-of-day to seconds offset from start_hour on day 0
def is_active(t_sec):
    """Return bool array: True if shot at time t_sec is in active window."""
    # time-of-day in seconds (0 = midnight)
    tod = (t_sec + start_hour * 3600) % 86400
    return (tod >= hour_on * 3600) & (tod < hour_off * 3600)

T_span_total = n_days * 86400   # full week in seconds
N_grid       = int(T_span_total / T_cyc)

# all candidate shot times (measurement time = start + T_fly)
t_starts_all = np.arange(N_grid) * T_cyc
t_meas_all   = t_starts_all + T_fly

active = is_active(t_meas_all)
t_starts_active = t_starts_all[active]
t_meas_active   = t_meas_all[active]
N_active = len(t_meas_active)

# print schedule summary
active_per_day = (hour_off - hour_on) * 3600 / T_cyc
print(f"Schedule: ON {hour_on:02d}:00 – {hour_off % 24:02d}:00  "
      f"({hour_off-hour_on}h active, {hour_on}h off per day)")
print(f"Start: Monday {start_hour:02d}:00")
print(f"Total grid shots : {N_grid:,}")
print(f"Active shots     : {N_active:,}  ({100*N_active/N_grid:.1f}%)")

# ── arm positions ──────────────────────────────────────────────────────────────
lower1 = arm_positions(0,0,upper=False);  upper1 = arm_positions(0,0,upper=True)
lower2 = arm_positions(5,5,upper=False);  upper2 = arm_positions(5,5,upper=True)

# ── phase computation ─────────────────────────────────────────────────────────
phases = np.zeros(N_active)
phases += uldm_phase_vec(t_meas_active)

print(f"Computing {N_active:,} phases...")
for i in range(N_active):
    t_abs      = t_starts_active[i] + t_local
    h_k        = h_0 + A * np.cos(2*np.pi*f_sig*t_abs)
    pd         = ((V(upper1, h_k) - V(lower1, h_k))
                 -(V(upper2, h_k) - V(lower2, h_k)))
    phases[i] += (m_atom/hbar) * np.trapezoid(pd, t_local)
    if (i+1) % 10000 == 0:
        print(f"  {i+1:,}/{N_active:,}")

# ── FFT: surviving shots treated as uniformly spaced ─────────────────────────
y_fft  = phases - phases.mean()
f_fft  = np.fft.rfftfreq(N_active, d=T_cyc)
S_fft  = (T_cyc/N_active) * np.abs(np.fft.rfft(y_fft))**2
f_nyq  = 1/(2*T_cyc)
m_fft  = (f_fft > 0) & (f_fft <= f_nyq + 0.05)

# ── LS: on active timestamps ──────────────────────────────────────────────────
f_grid = np.linspace(1/T_span_total, f_nyq + 0.05, 8000)
print("Computing LS...")
S_ls   = ls_psd(t_meas_active, phases, f_grid)

# ── figure ─────────────────────────────────────────────────────────────────────
fig, (ax_f, ax_l) = plt.subplots(1, 2, figsize=(15, 5))

ax_f.plot(f_fft[m_fft], np.sqrt(S_fft[m_fft]), color='steelblue', lw=0.7)
ax_f.axvline(f_sig,  ls='--', color='k',        lw=1.2,
             label=rf'$f_{{\rm GGN}}={f_sig}$ Hz')
ax_f.axvline(f_uldm, ls='--', color='firebrick', lw=1.2,
             label=rf'$f_{{\rm ULDM}}={f_uldm}$ Hz')
ax_f.axvline(f_nyq,  ls=':',  color='grey',      lw=1.0,
             label=f'Nyquist = {f_nyq:.3f} Hz')
ax_f.set_xlabel('$f$ [Hz]', fontsize=12)
ax_f.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\rm Hz}$]', fontsize=12)
ax_f.set_title('FFT — surviving shots treated as uniform\n'
               '(timing errors from gaps distort spectrum)', fontsize=11)
ax_f.legend(fontsize=9)
ax_f.set_xlim(0, f_nyq + 0.05)

ax_l.plot(f_grid, np.sqrt(S_ls), color='seagreen', lw=0.7)
ax_l.axvline(f_sig,  ls='--', color='k',        lw=1.2,
             label=rf'$f_{{\rm GGN}}={f_sig}$ Hz')
ax_l.axvline(f_uldm, ls='--', color='firebrick', lw=1.2,
             label=rf'$f_{{\rm ULDM}}={f_uldm}$ Hz')
ax_l.set_xlabel('$f$ [Hz]', fontsize=12)
ax_l.set_title('Lomb-Scargle — active timestamps only\n'
               '(handles gaps correctly)', fontsize=11)
ax_l.legend(fontsize=9)
ax_l.set_xlim(0, f_nyq + 0.05)

active_h = hour_off - hour_on
fig.suptitle(f'{n_days}-day run: ON {hour_on:02d}:00–{hour_off%24:02d}:00 '
             f'({active_h}h/day active), start Monday {start_hour:02d}:00  |  '
             f'$T_{{\\rm cyc}}={T_cyc}$ s,  $N_{{\\rm active}}={N_active:,}$',
             fontsize=11)
fig.tight_layout()
plt.show()

print(f"\n  GGN peak  (LS): "
      f"{np.sqrt(S_ls[(f_grid>=f_sig-0.02)&(f_grid<=f_sig+0.02)].max()):.4e}")
print(f"  ULDM peak (LS): "
      f"{np.sqrt(ls_psd(t_meas_active, phases, np.array([f_uldm]))[0]):.4e}")

# ── raw time series ────────────────────────────────────────────────────────────
t_days = t_meas_active / 86400   # convert to days

fig2, ax = plt.subplots(figsize=(15, 4))
ax.plot(t_days, phases * 1e6, color='steelblue', lw=0.4, rasterized=True)

# shade the nighttime gaps
for day in range(n_days + 1):
    # gap: from midnight (day boundary) to hour_on
    gap_start = day - (24 - hour_off) / 24   # fraction of day
    gap_end   = day + hour_on / 24
    ax.axvspan(gap_start, gap_end, color='lightgrey', alpha=0.6, zorder=0)
# label one
ax.axvspan(np.nan, np.nan, color='lightgrey', alpha=0.6,
           label=f'Shutdown ({hour_off%24:02d}:00–{hour_on:02d}:00)')

ax.set_xlabel('Time [days from Monday {:02d}:00]'.format(start_hour), fontsize=12)
ax.set_ylabel(r'$\Delta\Phi$ [µrad]', fontsize=12)
ax.set_title(f'Raw differential phase — {n_days}-day run', fontsize=12)
ax.set_xlim(0, n_days)
ax.legend(fontsize=10)
fig2.tight_layout()
plt.show()

# ════════════════════════════════════════════════════════════════════════════════
# Part 2: jittered nighttime — ±30 min uniform on/off times
# ════════════════════════════════════════════════════════════════════════════════
rng2     = np.random.default_rng(123)
jitter_s = 60 * 60   # 30 min in seconds

on_times  = hour_on  * 3600 + rng2.uniform(-jitter_s, jitter_s, n_days)
off_times = np.clip(hour_off * 3600 + rng2.uniform(-jitter_s, jitter_s, n_days),
                    None, 86400)

tod_all     = (t_meas_all + start_hour * 3600) % 86400
day_idx_all = ((t_meas_all + start_hour * 3600) // 86400).astype(int)

active2 = np.zeros(N_grid, dtype=bool)
for d in range(n_days):
    active2 |= (day_idx_all == d) & (tod_all >= on_times[d]) & (tod_all < off_times[d])

t_starts_active2 = t_starts_all[active2]
t_meas_active2   = t_meas_all[active2]
N_active2        = len(t_meas_active2)

print(f"\nJittered schedule: {N_active2:,} active shots  ({100*N_active2/N_grid:.1f}%)")

# ── phases ────────────────────────────────────────────────────────────────────
phases2  = np.zeros(N_active2)
phases2 += uldm_phase_vec(t_meas_active2)

print(f"Computing {N_active2:,} phases...")
for i in range(N_active2):
    t_abs      = t_starts_active2[i] + t_local
    h_k        = h_0 + A * np.cos(2*np.pi*f_sig*t_abs)
    pd         = ((V(upper1, h_k) - V(lower1, h_k))
                 -(V(upper2, h_k) - V(lower2, h_k)))
    phases2[i] += (m_atom/hbar) * np.trapezoid(pd, t_local)
    if (i+1) % 10000 == 0:
        print(f"  {i+1:,}/{N_active2:,}")

# ── FFT ───────────────────────────────────────────────────────────────────────
y_fft2 = phases2 - phases2.mean()
f_fft2 = np.fft.rfftfreq(N_active2, d=T_cyc)
S_fft2 = (T_cyc/N_active2) * np.abs(np.fft.rfft(y_fft2))**2
m_fft2 = (f_fft2 > 0) & (f_fft2 <= f_nyq + 0.05)

# ── LS ────────────────────────────────────────────────────────────────────────
print("Computing LS...")
S_ls2 = ls_psd(t_meas_active2, phases2, f_grid)

# ── figure ────────────────────────────────────────────────────────────────────
fig3, (ax_f3, ax_l3) = plt.subplots(1, 2, figsize=(15, 5))

ax_f3.plot(f_fft2[m_fft2], np.sqrt(S_fft2[m_fft2]), color='steelblue', lw=0.7)
ax_f3.axvline(f_sig,  ls='--', color='k',        lw=1.2,
              label=rf'$f_{{\rm GGN}}={f_sig}$ Hz')
ax_f3.axvline(f_uldm, ls='--', color='firebrick', lw=1.2,
              label=rf'$f_{{\rm ULDM}}={f_uldm}$ Hz')
ax_f3.axvline(f_nyq,  ls=':',  color='grey',      lw=1.0,
              label=f'Nyquist = {f_nyq:.3f} Hz')
ax_f3.set_xlabel('$f$ [Hz]', fontsize=12)
ax_f3.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\rm Hz}$]', fontsize=12)
ax_f3.set_title('FFT — jittered schedule, shots treated as uniform\n'
                '(incoherent gap phases smear the spectrum)', fontsize=11)
ax_f3.legend(fontsize=9)
ax_f3.set_xlim(0, f_nyq + 0.05)

ax_l3.plot(f_grid, np.sqrt(S_ls2), color='seagreen', lw=0.7)
ax_l3.axvline(f_sig,  ls='--', color='k',        lw=1.2,
              label=rf'$f_{{\rm GGN}}={f_sig}$ Hz')
ax_l3.axvline(f_uldm, ls='--', color='firebrick', lw=1.2,
              label=rf'$f_{{\rm ULDM}}={f_uldm}$ Hz')
ax_l3.set_xlabel('$f$ [Hz]', fontsize=12)
ax_l3.set_title('Lomb-Scargle — jittered timestamps\n'
                '(still recovers both peaks correctly)', fontsize=11)
ax_l3.legend(fontsize=9)
ax_l3.set_xlim(0, f_nyq + 0.05)

fig3.suptitle(f'{n_days}-day run, ±30 min on/off jitter  |  '
              f'$T_{{\\rm cyc}}={T_cyc}$ s,  $N_{{\\rm active}}={N_active2:,}$',
              fontsize=11)
fig3.tight_layout()
plt.show()

print(f"\n  GGN peak  (LS, jittered): "
      f"{np.sqrt(S_ls2[(f_grid>=f_sig-0.02)&(f_grid<=f_sig+0.02)].max()):.4e}")
print(f"  ULDM peak (LS, jittered): "
      f"{np.sqrt(ls_psd(t_meas_active2, phases2, np.array([f_uldm]))[0]):.4e}")