# -*- coding: utf-8 -*-
"""
One week of data with daily gaps (nighttime shutdown).

Schedule (all times as hours, 24h clock):
  Device ON  from hour_on  to midnight  (e.g. 08:00 – 24:00)
  Device OFF from midnight to hour_on   (e.g. 00:00 – 08:00)
  First day starts at start_hour        (e.g. Monday 09:00)

"""
import numpy as np
import matplotlib.pyplot as plt

# ── adjustable schedule ────────────────────────────────────────────────────────
T_cyc       = 2.0     # cycle time [s]
hour_on     = 8       # daily switch-on hour (24h clock)
hour_off    = 24      # daily switch-off hour (midnight = 24)
start_hour  = 9       # first shot hour on Monday
n_days      = 7       # number of days

# ── physics parameters ─────────────────────────────────────────────────────────
d_e = 1;  d_m_e = 1
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11;  g = 9.81;  M = 1;  h_0 = 1;  D_0 = 5;  A = 1
f_sig = 0.123
u0 = 3.86;  dt = 0.01;  T = 0.73
T_fly = 2*T;  N_fly = int(round(T_fly/dt));  t_local = np.arange(N_fly)*dt

G_nat = 6.708e-39;  m_phi = 4e-16;  rho_phi = 0.3;  f_uldm = 0.1
theta = np.pi/2;  xi = 0.06;  omega_A = 2.67e15
L_base = 10;  delta_r = 5;  n_lmt = 1000;  conv_factor = 2.77e-12

def uldm_phase_vec(t):
    delta_omega_A = (omega_A*np.sqrt(G_nat*4*np.pi)*(d_m_e+(2+xi)*d_e)
                     *(np.sqrt(2*rho_phi)/m_phi)*conv_factor)
    omega_phi = 2*np.pi*f_uldm
    return (8*(delta_omega_A/omega_phi)*(delta_r/L_base)
            *np.sin(omega_phi*n_lmt*L_base/(2*3e8))
            *np.sin(omega_phi*(T-(n_lmt-1)*L_base/3e8)/2)
            *np.sin(omega_phi*T/2)
            *np.cos(omega_phi*((T_fly+L_base/3e8)/2+t)+theta))

def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0+k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _ = atom_path(p1[-1] if len(p1) else float(floor), v1+k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly-len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G*M/np.sqrt(D_0**2+(z-h)**2)

def ls_psd(t, y, freqs, chunk=64):
    y = y - y.mean()
    dt_eff = (t[-1]-t[0])/(len(t)-1)
    out = np.empty(len(freqs))
    for i in range(0, len(freqs), chunk):
        w  = 2*np.pi*freqs[i:i+chunk]
        wt = np.outer(w, t)
        tau = np.arctan2(np.sin(2*wt).sum(1), np.cos(2*wt).sum(1))/(2*w)
        sh  = wt - (w*tau)[:,None]
        ct  = np.cos(sh);  st = np.sin(sh)
        C   = ct@y;  S  = st@y
        CC  = (ct**2).sum(1);  SS = (st**2).sum(1)
        out[i:i+chunk] = dt_eff*0.5*(C**2/CC + S**2/SS)
    return out

# ── shared time grid ───────────────────────────────────────────────────────────
T_span_total = n_days * 86400
N_grid       = int(T_span_total / T_cyc)
t_starts_all = np.arange(N_grid) * T_cyc
t_meas_all   = t_starts_all + T_fly
t_abs_all    = t_meas_all + start_hour * 3600   # seconds from Monday midnight

f_nyq  = 1 / (2 * T_cyc)
f_grid = np.linspace(1/T_span_total, f_nyq + 0.05, 8000)

# ── arm positions (shared) ─────────────────────────────────────────────────────
lower1 = arm_positions(0, 0, upper=False);  upper1 = arm_positions(0, 0, upper=True)
lower2 = arm_positions(5, 5, upper=False);  upper2 = arm_positions(5, 5, upper=True)

# ── plot helper ────────────────────────────────────────────────────────────────
def make_figure(suptitle, t_meas_active, phases, gap_bands, S_ls, ls_subtitle=''):
    """
    gap_bands: list of (start_tdays, end_tdays) tuples for grey shading.
    t_meas_active: shot times in seconds from Monday start_hour:00.
    """
    fig = plt.figure(figsize=(15, 8))
    gs  = fig.add_gridspec(2, 1, height_ratios=[1, 1.4], hspace=0.4)
    ax_ts = fig.add_subplot(gs[0])
    ax_l  = fig.add_subplot(gs[1])

    # ── time series ──
    t_days = t_meas_active / 86400
    ax_ts.plot(t_days, phases * 1e6, color='steelblue', lw=0.4, rasterized=True)
    for (g0, g1) in gap_bands:
        ax_ts.axvspan(g0, g1, color='lightgrey', alpha=0.6, zorder=0)
    ax_ts.axvspan(np.nan, np.nan, color='lightgrey', alpha=0.6, label='Shutdown')
    ax_ts.set_xlabel(f'Time [days from Monday {start_hour:02d}:00]', fontsize=11)
    ax_ts.set_ylabel(r'$\Delta\Phi$ [µrad]', fontsize=11)
    ax_ts.set_title('Raw differential phase', fontsize=11)
    ax_ts.set_xlim(0, n_days)
    ax_ts.legend(fontsize=9)

    # ── Lomb-Scargle ──
    ax_l.plot(f_grid, np.sqrt(S_ls), color='seagreen', lw=0.7)
    tr = ax_l.get_xaxis_transform()
    ax_l.text(f_sig,  1.02, rf'$f_{{\rm GGN}}$',  transform=tr,
              ha='center', va='bottom', fontsize=9, color='k')
    ax_l.text(f_uldm, 1.02, rf'$f_{{\rm ULDM}}$', transform=tr,
              ha='center', va='bottom', fontsize=9, color='firebrick')
    ax_l.set_xlabel('$f$ [Hz]', fontsize=11)
    ax_l.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\rm Hz}$]', fontsize=11)
    ax_l.set_title(f'Lomb-Scargle — true timestamps\n{ls_subtitle}', fontsize=10)
    ax_l.set_xlim(0, f_nyq + 0.05)

    fig.suptitle(suptitle, fontsize=12)
    fig.tight_layout()
    return fig

# ════════════════════════════════════════════════════════════════════════════════
# Part 1: uniform nighttime — fixed on/off times every day
# ════════════════════════════════════════════════════════════════════════════════
def is_active(t_meas):
    tod = (t_meas + start_hour * 3600) % 86400
    return (tod >= hour_on * 3600) & (tod < hour_off * 3600)

active          = is_active(t_meas_all)
t_starts_active = t_starts_all[active]
t_meas_active   = t_meas_all[active]
N_active        = len(t_meas_active)

print(f"Schedule: ON {hour_on:02d}:00 – {hour_off % 24:02d}:00  "
      f"({hour_off-hour_on}h active, {hour_on}h off per day)")
print(f"Start: Monday {start_hour:02d}:00")
print(f"Total grid shots : {N_grid:,}")
print(f"Active shots     : {N_active:,}  ({100*N_active/N_grid:.1f}%)")

phases = np.zeros(N_active)
phases += uldm_phase_vec(t_meas_active)

print(f"Computing {N_active:,} phases...")
for i in range(N_active):
    t_abs      = t_starts_active[i] + t_local
    h_k        = h_0 + A * np.cos(2*np.pi*f_sig*t_abs)
    pd         = ((V(upper1, h_k) - V(lower1, h_k))
                 - (V(upper2, h_k) - V(lower2, h_k)))
    phases[i] += (m_atom/hbar) * np.trapezoid(pd, t_local)
    if (i+1) % 10000 == 0:
        print(f"  {i+1:,}/{N_active:,}")

print("Computing LS...")
S_ls = ls_psd(t_meas_active, phases, f_grid)

# gap bands: night d runs from hour_off on day d to hour_on on day d+1
gap_bands1 = []
for d in range(n_days):
    gs_abs = d * 86400 + hour_off * 3600
    ge_abs = (d+1) * 86400 + hour_on * 3600
    gap_bands1.append(((gs_abs - start_hour*3600) / 86400,
                        (ge_abs - start_hour*3600) / 86400))

make_figure(
    suptitle=(f'{n_days}-day run: ON {hour_on:02d}:00–{hour_off%24:02d}:00 '
              f'({hour_off-hour_on}h/day active), start Monday {start_hour:02d}:00  |  '
              f'$T_{{\\rm cyc}}={T_cyc}$ s,  $N_{{\\rm active}}={N_active:,}$'),
    t_meas_active=t_meas_active, phases=phases, gap_bands=gap_bands1,
    S_ls=S_ls, ls_subtitle='(handles gaps correctly)',
)

print(f"\n  GGN peak  (LS): "
      f"{np.sqrt(S_ls[(f_grid>=f_sig-0.02)&(f_grid<=f_sig+0.02)].max()):.4e}")
print(f"  ULDM peak (LS): "
      f"{np.sqrt(ls_psd(t_meas_active, phases, np.array([f_uldm]))[0]):.4e}")

# ════════════════════════════════════════════════════════════════════════════════
# Part 2: jittered nighttime — ±30 min uniform on/off times
# ════════════════════════════════════════════════════════════════════════════════
rng2     = np.random.default_rng(123)
jitter_s = 30 * 60   # ±30 min in seconds

on_times2  = hour_on  * 3600 + rng2.uniform(-jitter_s, jitter_s, n_days)
off_times2 = np.clip(hour_off * 3600 + rng2.uniform(-jitter_s, jitter_s, n_days),
                     None, 86400)

day_idx_all = (t_abs_all // 86400).astype(int)
tod_all     = t_abs_all % 86400

active2 = np.zeros(N_grid, dtype=bool)
for d in range(n_days):
    active2 |= ((day_idx_all == d) & (tod_all >= on_times2[d])
                                    & (tod_all <  off_times2[d]))

t_starts_active2 = t_starts_all[active2]
t_meas_active2   = t_meas_all[active2]
N_active2        = len(t_meas_active2)

print(f"\nJittered schedule (±30 min): {N_active2:,} active shots  "
      f"({100*N_active2/N_grid:.1f}%)")

phases2  = np.zeros(N_active2)
phases2 += uldm_phase_vec(t_meas_active2)

print(f"Computing {N_active2:,} phases...")
for i in range(N_active2):
    t_abs      = t_starts_active2[i] + t_local
    h_k        = h_0 + A * np.cos(2*np.pi*f_sig*t_abs)
    pd         = ((V(upper1, h_k) - V(lower1, h_k))
                 - (V(upper2, h_k) - V(lower2, h_k)))
    phases2[i] += (m_atom/hbar) * np.trapezoid(pd, t_local)
    if (i+1) % 10000 == 0:
        print(f"  {i+1:,}/{N_active2:,}")

print("Computing LS...")
S_ls2 = ls_psd(t_meas_active2, phases2, f_grid)

# gap bands: one inter-day interval per night
gap_bands2 = []
for d in range(n_days - 1):
    gs_abs = d * 86400 + off_times2[d]
    ge_abs = (d+1) * 86400 + on_times2[d+1]
    gap_bands2.append(((gs_abs - start_hour*3600) / 86400,
                        (ge_abs - start_hour*3600) / 86400))
# last shutdown (no next morning to bound it — shade to edge of plot)
gs_abs = (n_days-1) * 86400 + off_times2[n_days-1]
gap_bands2.append(((gs_abs - start_hour*3600) / 86400, n_days))

make_figure(
    suptitle=(f'{n_days}-day run, ±30 min on/off jitter  |  '
              f'$T_{{\\rm cyc}}={T_cyc}$ s,  $N_{{\\rm active}}={N_active2:,}$'),
    t_meas_active=t_meas_active2, phases=phases2, gap_bands=gap_bands2,
    S_ls=S_ls2, ls_subtitle='(still recovers both peaks correctly)',
)

print(f"\n  GGN peak  (LS, jittered): "
      f"{np.sqrt(S_ls2[(f_grid>=f_sig-0.02)&(f_grid<=f_sig+0.02)].max()):.4e}")
print(f"  ULDM peak (LS, jittered): "
      f"{np.sqrt(ls_psd(t_meas_active2, phases2, np.array([f_uldm]))[0]):.4e}")

# ════════════════════════════════════════════════════════════════════════════════
# Part 3: variable gap lengths and start times each night
# ════════════════════════════════════════════════════════════════════════════════
rng3 = np.random.default_rng(456)
# shutdown start: anywhere 20:00–02:00 (expressed as hours from midnight, so 20–26)
# duration: 4–12 hours; turn-on = start + duration
off_hours3 = rng3.uniform(20, 26, n_days)
dur_hours3 = rng3.uniform(4,  12, n_days)
on_hours3  = off_hours3 + dur_hours3

# absolute seconds from Monday midnight for each gap
gap_starts3_abs = np.array([d * 86400 + off_hours3[d] * 3600 for d in range(n_days)])
gap_ends3_abs   = np.array([d * 86400 + on_hours3[d]  * 3600 for d in range(n_days)])

active3 = np.ones(N_grid, dtype=bool)
for gs, ge in zip(gap_starts3_abs, gap_ends3_abs):
    active3 &= ~((t_abs_all >= gs) & (t_abs_all < ge))

t_starts_active3 = t_starts_all[active3]
t_meas_active3   = t_meas_all[active3]
N_active3        = len(t_meas_active3)

print(f"\nVariable gap schedule: {N_active3:,} active shots  "
      f"({100*N_active3/N_grid:.1f}%)")
for d in range(n_days):
    print(f"  Night {d}: off {off_hours3[d]%24:.1f}h, "
          f"on {on_hours3[d]%24:.1f}h  (duration {dur_hours3[d]:.1f}h)")

phases3  = np.zeros(N_active3)
phases3 += uldm_phase_vec(t_meas_active3)

print(f"Computing {N_active3:,} phases...")
for i in range(N_active3):
    t_abs_i    = t_starts_active3[i] + t_local
    h_k        = h_0 + A * np.cos(2*np.pi*f_sig*t_abs_i)
    pd         = ((V(upper1, h_k) - V(lower1, h_k))
                 - (V(upper2, h_k) - V(lower2, h_k)))
    phases3[i] += (m_atom/hbar) * np.trapezoid(pd, t_local)
    if (i+1) % 10000 == 0:
        print(f"  {i+1:,}/{N_active3:,}")

print("Computing LS...")
S_ls3 = ls_psd(t_meas_active3, phases3, f_grid)

gap_bands3 = [((gs - start_hour*3600) / 86400, (ge - start_hour*3600) / 86400)
              for gs, ge in zip(gap_starts3_abs, gap_ends3_abs)]

make_figure(
    suptitle=(f'{n_days}-day run, variable shutdowns (4–12 h, start 20:00–02:00)  |  '
              f'$T_{{\\rm cyc}}={T_cyc}$ s,  $N_{{\\rm active}}={N_active3:,}$'),
    t_meas_active=t_meas_active3, phases=phases3, gap_bands=gap_bands3,
    S_ls=S_ls3, ls_subtitle='(correctly recovers both peaks)',
)

print(f"\n  GGN peak  (LS, variable): "
      f"{np.sqrt(S_ls3[(f_grid>=f_sig-0.02)&(f_grid<=f_sig+0.02)].max()):.4e}")
print(f"  ULDM peak (LS, variable): "
      f"{np.sqrt(ls_psd(t_meas_active3, phases3, np.array([f_uldm]))[0]):.4e}")

plt.show()
