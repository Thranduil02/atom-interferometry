# -*- coding: utf-8 -*-
"""
Uniform cadence with random shot failures — FFT vs Lomb-Scargle comparison.

Each cycle independently fails with probability p_fail.
FFT is applied to the full uniform grid with failed shots zero-filled.
LS uses only the surviving measurement times.

This illustrates why FFT fails on gapped data while LS handles it naturally.
"""
import numpy as np
import matplotlib.pyplot as plt

# ── parameters ─────────────────────────────────────────────────────────────────
T_cyc    = 2.0                     # uniform cycle time [s]
N_total  = int(1e6 / T_cyc)        # total shots attempted (total run time ~1e6 s)
p_fail   = 0.01      # probability of a shot failing
N_real   = 20         # realisations averaged per p value in fig 5
rng_seed = 42
d_e = 1;  d_m_e = 1

# ── constants ──────────────────────────────────────────────────────────────────
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11;  g = 9.81;  M = 1;  h_0 = 1;  D_0 = 5;  A = 1
f_sig = 0.12
u0 = 3.86;  dt = 0.01;  T = 0.73
T_fly = 2*T;  N_fly = int(round(T_fly/dt));  t_local = np.arange(N_fly)*dt

G_nat = 6.708e-39;  m_phi = 4e-16;  rho_phi = 0.3;  f_uldm = 0.1
theta = np.pi/2;  xi = 0.06;  omega_A = 2.67e15
L_base = 10;  delta_r = 5;  n_lmt = 1000;  conv_factor = 2.77e-12

def uldm_phase(t):
    delta_omega_A = (omega_A*np.sqrt(G_nat*4*np.pi)*(d_m_e+(2+xi)*d_e)
                     *(np.sqrt(2*rho_phi)/m_phi)*conv_factor)
    omega_phi = 2*np.pi*f_uldm
    return (8*(delta_omega_A/omega_phi)*(delta_r/L_base)
            *np.sin(omega_phi*n_lmt*L_base/(2*3e8))
            *np.sin(omega_phi*(T-(n_lmt-1)*L_base/3e8)/2)
            *np.sin(omega_phi*T/2)
            *np.cos(omega_phi*((T_fly+L_base/3e8)/2+t)+theta))

def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0+k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _ = atom_path(p1[-1] if len(p1) else float(floor), v1+k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly-len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G*M/np.sqrt(D_0**2+(z-h)**2)

def ls_psd(t, y, freqs, chunk=256):
    y = y - y.mean()
    dt_eff = (t[-1]-t[0])/(len(t)-1)
    out = np.empty(len(freqs))
    for i in range(0, len(freqs), chunk):
        w  = 2*np.pi*freqs[i:i+chunk]
        wt = np.outer(w, t)
        tau = np.arctan2(np.sin(2*wt).sum(1), np.cos(2*wt).sum(1))/(2*w)
        sh  = wt - (w*tau)[:,None]
        ct  = np.cos(sh);  st = np.sin(sh)
        C   = ct@y;  S  = st@y
        CC  = (ct**2).sum(1);  SS = (st**2).sum(1)
        out[i:i+chunk] = dt_eff*0.5*(C**2/CC + S**2/SS)
    return out

# ── arm positions ──────────────────────────────────────────────────────────────
lower1 = arm_positions(0,0,upper=False);  upper1 = arm_positions(0,0,upper=True)
lower2 = arm_positions(5,5,upper=False);  upper2 = arm_positions(5,5,upper=True)

# ── uniform cadence — precompute phases for all shots ─────────────────────────
rng     = np.random.default_rng(rng_seed)
all_idx = np.arange(N_total)
t_all   = all_idx * T_cyc + T_fly

print("Computing phases for all shots...")
phases_all = np.empty(N_total)
chunk = 50_000   # bounds memory: chunk * N_fly elements per temporary array
for start in range(0, N_total, chunk):
    end      = min(start + chunk, N_total)
    t_starts = all_idx[start:end] * T_cyc
    t_abs    = t_starts[:, None] + t_local[None, :]        # (chunk, N_fly)
    h_k      = h_0 + A*np.cos(2*np.pi*f_sig*t_abs)
    pd1      = V(upper1, h_k) - V(lower1, h_k)
    pd2      = V(upper2, h_k) - V(lower2, h_k)
    phases_all[start:end] = ((m_atom/hbar)*np.trapezoid(pd1-pd2, t_local, axis=1)
                              + uldm_phase(t_all[start:end]))
    print(f"  shots {end}/{N_total} done", flush=True)

# ── shared frequency grid (used for both figures) ─────────────────────────────
f_nyq  = 1/(2*T_cyc)
f_max  = f_nyq + 0.05
f_grid = np.linspace(0.5/(N_total*T_cyc), f_max, 8000)

_peak_mask = (
    ((f_grid >= f_sig  - 0.02) & (f_grid <= f_sig  + 0.02)) |
    ((f_grid >= f_uldm - 0.01) & (f_grid <= f_uldm + 0.01))
)
_mask_uldm_peak = (f_grid >= f_uldm - 0.01) & (f_grid <= f_uldm + 0.01)

def noise_floor(S):
    return np.median(np.sqrt(S[~_peak_mask]))

# ── plot style ────────────────────────────────────────────────────────────────
warm_background = False   # set True to use off-white background (#fdfcf3) on all plots
if warm_background:
    plt.rcParams['figure.facecolor'] = '#fdfcf3'
    plt.rcParams['axes.facecolor']   = '#fdfcf3'

# ── figure 1: 2 stacked panels, Lomb-Scargle only, p_fail = 1/10% ──────────────
p_list = [0.01, 0.10]
labels = ['1 %', '10 %']

fig, axes = plt.subplots(2, 1, figsize=(10, 9))

for ax, p, lab in zip(axes, p_list, labels):
    survived   = rng.random(N_total) >= p
    N_survived = survived.sum()
    t_good      = t_all[survived]
    phases_good = phases_all[survived]

    # LS on the surviving timestamps only
    S_ls = ls_psd(t_good, phases_good, f_grid)
    ax.plot(f_grid, np.sqrt(S_ls), color='firebrick', lw=0.8, label='Lomb-Scargle')

    ax.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\rm Hz}$]', fontsize=16)
    ax.set_title(f'Failure rate: {lab}  ($N_\\mathrm{{survived}}={N_survived}$)', fontsize=11)
    ax.tick_params(labelsize=11)
    print(f"  p_fail={100*p:.0f}%  N_survived={N_survived}  "
          f"noise floor = {noise_floor(S_ls):.4e} rad/sqrt(Hz)")

axes[0].legend(fontsize=9)
axes[-1].set_xlabel('$f$ [Hz]', fontsize=16)
fig.suptitle(f'Gapped uniform cadence: $N_\\mathrm{{total}}={N_total}$, '
             f'$T_\\mathrm{{cyc}}={T_cyc}$ s — Lomb-Scargle', fontsize=12)
fig.tight_layout()

