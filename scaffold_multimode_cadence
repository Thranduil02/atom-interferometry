# -*- coding: utf-8 -*-
"""
scaffold_multimode with non-uniform cadences (AION-10 params).

Same scaffold, modes, potential grid and per-measurement quad integral as
scaffold_multimode; only the launch times change:
  - random jitter:  cycle time T_c ~ Uniform(T_nom, T_nom + delta), T_nom = 2 s,
                    delta in JITTER_DELTAS (delta = 0 is the uniform cadence);
  - structured:     cycle times alternating T_A, T_B, ... for (T_A, T_B) in STACK_PAIRS.
A ULDM tone (f_phi = 0.05 Hz) and stretch noise (1e-5) are added as in
scaffold_multimode. The sampling is non-uniform, so the spectra are Lomb-Scargle
(ls_psd from cadence_grid_new) instead of the FFT.

Figures: the jitter cadences stacked, and the structured cadences stacked; each
panel shows the noisy periodogram with the scaffold (GGN) and ULDM periodograms on top.
"""

import os
import time

import numpy as np
import matplotlib.pyplot as plt
from scipy import integrate
from scipy.integrate import quad
from scipy.interpolate import RectBivariateSpline, interp1d

# ── Cadences ──────────────────────────────────────────────────────────────────
N_CYC         = 5000                     # measurements per cadence
T_nom         = 2.0                      # nominal cycle time [s]
JITTER_DELTAS = [0.0, 0.1, 0.2, 0.5]     # T_c ~ U(T_nom, T_nom + delta) [s]
STACK_PAIRS   = [(2.0, 2.5), (2.0, 3.0)] # alternating cycle times (T_A, T_B) [s]
F_LO, F_HI    = 1e-3, 1 / T_nom          # periodogram range [Hz]
SEED          = 0

# ── Constants ─────────────────────────────────────────────────────────────────
G              = 6.67430e-11
u_initial      = 3.86
m_atom         = 1.46e-25
hbar           = 1.055e-34
wavelength     = 698e-9
wavenumber     = 2 * np.pi / wavelength
T              = 0.73
n_kicks        = 1000
velocity_boost = n_kicks * hbar * wavenumber / m_atom
g              = 9.81

# ── Steel scaffold parameters ─────────────────────────────────────────────────
rho_steel = 7850.0
R_edge    = 0.0338
L_cube    = 1.0
N_cubes   = 10
H_total   = N_cubes * L_cube   # 10 m

M_edge = rho_steel * np.pi * R_edge**2 * L_cube
print(f"Steel edge: R={R_edge*1000:.0f} mm, L={L_cube:.1f} m, M_edge={M_edge:.2f} kg")

# ── Build scaffold member list ────────────────────────────────────────────────
h = L_cube / 2.0

members = []

H_col = N_cubes * L_cube
M_col = rho_steel * np.pi * R_edge**2 * H_col
for sy in (-1, 1):
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': sy * h, 'dz': H_col / 2.0,
            'M': M_col, 'R': R_edge, 'H': H_col, 'axis': 'z'
        })

for k in range(N_cubes + 1):
    z_ring = k * L_cube
    for sy in (-1, 1):
        members.append({
            'dx': 0.0, 'dy': sy * h, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'x'
        })
    for sx in (-1, 1):
        members.append({
            'dx': sx * h, 'dy': 0.0, 'dz': z_ring,
            'M': M_edge, 'R': R_edge, 'H': L_cube, 'axis': 'y'
        })

total_mass = sum(m['M'] for m in members)
print(f"Tower: {len(members)} members, total mass = {total_mass:.1f} kg")

# ── Per-member oscillation amplitude (linear in z) ───────────────────────────
A_bottom = 1e-6   # 1 µm  at z = 0
A_top    = 1e-4   # 1 mm  at z = H_total

amplitudes = np.array([
    A_bottom + (A_top - A_bottom) * m['dz'] / H_total
    for m in members
])

# ── Oscillation modes ─────────────────────────────────────────────────────────
modes = [
    dict(f=2.30, scale=1.0,  phase=0.0),
    dict(f=2.34,  scale=1,  phase=0.0),
    dict(f=12.7, scale=1,  phase=0.0),
    dict(f=35.1, scale=1, phase=0),
    dict(f=37.0, scale=1, phase=0),
    dict(f=38.7, scale=1, phase=0),
    dict(f=39.4, scale=1, phase=0),
    dict(f=40.5, scale=1, phase=0)
]

def alpha_func(t):
    return sum(m['scale'] * np.cos(2 * np.pi * m['f'] * t + m['phase'])
               for m in modes)

# Grid must span the worst-case excursion of alpha
alpha_max = sum(abs(m['scale']) for m in modes)

# ── Gravitational potential of a single cylinder ──────────────────────────────
def cylinder_potential(x, y, z, cx, cy, cz, M, R, H, axis='z'):
    rho_vol = M / (np.pi * R**2 * H)
    def integrand(zp, rp, theta):
        local = np.array([rp * np.cos(theta), rp * np.sin(theta), zp])
        if   axis == 'z': dx, dy, dz = local[0], local[1], local[2]
        elif axis == 'x': dx, dy, dz = local[2], local[0], local[1]
        elif axis == 'y': dx, dy, dz = local[1], local[2], local[0]
        r = np.sqrt((x - cx - dx)**2 + (y - cy - dy)**2 + (z - cz - dz)**2)
        return -G * rho_vol * rp / r if r > 0 else 0.0
    result, _ = integrate.nquad(
        integrand,
        [[-H/2, H/2], [0, R], [0, 2*np.pi]],
        opts={'limit': 50}
    )
    return result


def scaffold_potential_mode(x, y, z, alpha, members, amplitudes):
    V = 0.0
    for m, A_i in zip(members, amplitudes):
        V += cylinder_potential(
            x, y, z,
            m['dx'] + A_i * alpha,
            m['dy'], m['dz'],
            m['M'], m['R'], m['H'], m['axis']
        )
    return V


# ── Atom trajectories ─────────────────────────────────────────────────────────
def atom_path(z_0, u, t_start, t_end, delta_t, acc, floor):
    timesteps = np.arange(t_start, t_end, delta_t)
    z, v = z_0, u
    z_positions = []
    for _ in timesteps:
        z += v * delta_t + 0.5 * acc * delta_t**2
        v += acc * delta_t
        if z <= floor and v < 0:
            z = floor; v = 0.0; break
        z_positions.append(z)
    return timesteps[:len(z_positions)], np.array(z_positions), v

def lower_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] + velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

def upper_arm(z_0, u, t_start, t_end, delta_t, acc, floor, total_time=2.0):
    seg1 = atom_path(z_0, u + velocity_boost, t_start, t_end, delta_t, acc, floor)
    seg2 = atom_path(seg1[1][-1], seg1[2] - velocity_boost, t_end, 2*t_end, delta_t, acc, floor)
    path = np.concatenate([seg1[1], seg2[1]])
    t    = np.concatenate([seg1[0], seg2[0]])
    if t[-1] < total_time:
        t_rem = np.arange(t[-1] + delta_t, total_time, delta_t)
        path  = np.concatenate([path, np.full_like(t_rem, floor)])
        t     = np.concatenate([t, t_rem])
    return t, path

# ── Build trajectories (one cycle, in time since launch) ──────────────────────
# Cycles no longer all last T_nom, so instead of concatenating N copies on a
# global time axis, each arm is built once and evaluated at t - t_launch.
dt = 0.01

t_l1, lower1 = lower_arm(0, u_initial, 0, T, dt, -g, 0, total_time=T_nom)
t_l2, lower2 = lower_arm(5, u_initial, 0, T, dt, -g, 5, total_time=T_nom)
t_u1, upper1 = upper_arm(0, u_initial, 0, T, dt, -g, 0, total_time=T_nom)
t_u2, upper2 = upper_arm(5, u_initial, 0, T, dt, -g, 5, total_time=T_nom)

interp_l1 = interp1d(t_l1, lower1, bounds_error=False, fill_value=(lower1[0], lower1[-1]))
interp_u1 = interp1d(t_u1, upper1, bounds_error=False, fill_value=(upper1[0], upper1[-1]))
interp_l2 = interp1d(t_l2, lower2, bounds_error=False, fill_value=(lower2[0], lower2[-1]))
interp_u2 = interp1d(t_u2, upper2, bounds_error=False, fill_value=(upper2[0], upper2[-1]))

x, y = 0.0, 0.0

print(f"\nAtom trajectories:")
print(f"  IFO 1 upper arm max height: {upper1.max():.2f} m")
print(f"  IFO 2 upper arm max height: {upper2.max():.2f} m")

# ── Cadences: launch times ────────────────────────────────────────────────────
def random_cadence(delta, n_cycles, seed=SEED):
    rng = np.random.default_rng(seed)
    T_cycles = rng.uniform(T_nom, T_nom + delta, n_cycles)
    return np.concatenate([[0.0], np.cumsum(T_cycles[:-1])])

def alternating_cadence(t_a, t_b, n_cycles):
    T_cycles = np.where(np.arange(n_cycles) % 2 == 0, t_a, t_b)
    return np.concatenate([[0.0], np.cumsum(T_cycles[:-1])])

cadences = ([dict(kind='jitter', par=d, t_launch=random_cadence(d, N_CYC)) for d in JITTER_DELTAS]
            + [dict(kind='alt', par=p, t_launch=alternating_cadence(*p, N_CYC)) for p in STACK_PAIRS])
assert min(np.diff(c['t_launch']).min() for c in cadences) >= 2 * T, "cycles would overlap"

# ── Progress bar with ETA (whole program) ─────────────────────────────────────
n_zgrid    = 30
n_alpha    = 12
GRID_WORK  = 20.0   # one potential-grid point costs about this many quad measurements
total_work = n_alpha * n_zgrid * GRID_WORK + len(cadences) * N_CYC
done_work, t_start = 0.0, time.time()

def show_progress(label):
    frac = min(done_work / total_work, 1.0)
    el   = time.time() - t_start
    eta  = el * (1 - frac) / frac if frac > 0 else float('nan')
    bar  = '#' * int(30 * frac) + '-' * (30 - int(30 * frac))
    print(chr(13) + f"[{bar}] {100*frac:5.1f}%  elapsed {el/60:6.1f} min  ETA {eta/60:6.1f} min  {label}   ",
          end='', flush=True)

# ── Potential grid ────────────────────────────────────────────────────────────
z_min_phys = 0.0
z_max_phys = max(upper1.max(), upper2.max()) + 0.5
z_grid     = np.linspace(z_min_phys, z_max_phys, n_zgrid)
alpha_grid = np.linspace(-alpha_max, alpha_max, n_alpha)

print(f"\nModes:")
for m in modes:
    print(f"  f={m['f']} Hz, scale={m['scale']}, phase={m['phase']:.2f} rad")
print(f"alpha range: [{-alpha_max:.2f}, {alpha_max:.2f}]")
print(f"\nPrecomputing potential grid ({n_alpha} x {n_zgrid} = {n_alpha*n_zgrid} points,"
      f" {len(members)} members each) ...")

V_grid = np.zeros((n_alpha, n_zgrid))
for i, alpha in enumerate(alpha_grid):
    for j, zj in enumerate(z_grid):
        V_grid[i, j] = scaffold_potential_mode(x, y, zj, alpha, members, amplitudes)
        done_work += GRID_WORK
        show_progress(f'potential grid row {i+1}/{n_alpha}')

V_interp = RectBivariateSpline(alpha_grid, z_grid, V_grid)

# ── Phase difference ──────────────────────────────────────────────────────────
def phase_differences(t_launch, label):
    """dp1 - dp2 for each cycle; measurement at t_c = t_launch + 2T."""
    dp1 = np.empty(len(t_launch))
    dp2 = np.empty(len(t_launch))
    global done_work
    for k, t0 in enumerate(t_launch):
        t_c = t0 + 2*T
        def ig1(t):
            a = alpha_func(t)
            return float(V_interp(a, float(interp_u1(t - t0)), grid=False)
                        - V_interp(a, float(interp_l1(t - t0)), grid=False))
        def ig2(t):
            a = alpha_func(t)
            return float(V_interp(a, float(interp_u2(t - t0)), grid=False)
                        - V_interp(a, float(interp_l2(t - t0)), grid=False))
        p1, _ = quad(ig1, t_c - 2*T, t_c, limit=100)
        p2, _ = quad(ig2, t_c - 2*T, t_c, limit=100)
        dp1[k] = (m_atom / hbar) * p1
        dp2[k] = (m_atom / hbar) * p2
        done_work += 1
        if k % 20 == 0:
            show_progress(label)
    return dp1 - dp2

# ── ULDM tone (as in scaffold_multimode, AION-10 baseline L_base = 10 m) ──────
delta_r     = 5.0     # gradiometer baseline: IFO2 sits 5 m above IFO1
T_fly       = 2 * T   # full interferometer flight time
f_phi       = 0.05    # ULDM Compton frequency [Hz]
hbar_eV     = 6.582119569e-16                 # hbar in eV*s
m_phi       = 2 * np.pi * f_phi * hbar_eV     # Compton relation
G_nat       = 6.708e-39
d_e         = 1e-3;  d_m_e      = 1e-3
rho_phi     = 0.3
uldm_theta  = np.pi / 2;  xi  = 0.06
omega_A     = 2.67e15
L_base      = 10.0
n_lmt       = n_kicks;  conv_factor = 2.77e-12
c_light     = 3e8

def uldm_phase_vec(t, f_uldm, m_phi_val):
    delta_omega_A = (omega_A * np.sqrt(G_nat * 4 * np.pi)
                     * (d_m_e + (2 + xi) * d_e)
                     * (np.sqrt(2 * rho_phi) / m_phi_val)
                     * conv_factor)
    omega_phi = 2 * np.pi * f_uldm
    return (8 * (delta_omega_A / omega_phi) * (delta_r / L_base)
            * np.sin(omega_phi * n_lmt * L_base / (2 * c_light))
            * np.sin(omega_phi * (T - (n_lmt - 1) * L_base / c_light) / 2)
            * np.cos(omega_phi * ((T_fly + L_base / c_light) / 2 + t) + uldm_theta))

# ── Lomb-Scargle periodogram (cadence_grid_new) ───────────────────────────────
def ls_psd(t, y, freqs, batch=200):
    """Scargle (1982) LS PSD; S(f) = dt_eff*(C²/CC + S²/SS)/2."""
    y = y - y.mean()
    dt_eff = (t[-1] - t[0]) / (len(t) - 1)
    S = np.empty_like(freqs)
    for i0 in range(0, len(freqs), batch):
        f_b = freqs[i0:i0 + batch]
        wt = np.outer(2 * np.pi * f_b, t)
        c = np.cos(wt);  s = np.sin(wt)
        Scc = np.einsum('ij,ij->i', c, c)
        Sss = np.einsum('ij,ij->i', s, s)
        Scs = np.einsum('ij,ij->i', c, s)
        Yc = c @ y;  Ys = s @ y
        a = 0.5 * np.arctan2(2 * Scs, Scc - Sss)          # w*tau
        ca = np.cos(a);  sa = np.sin(a)
        C = ca * Yc + sa * Ys
        Sn = ca * Ys - sa * Yc
        CC = ca**2 * Scc + sa**2 * Sss + 2 * ca * sa * Scs
        SS = ca**2 * Sss + sa**2 * Scc - 2 * ca * sa * Scs
        # on a uniform comb at f = k/(2 T_c) every sample has the same phase and one
        # quadrature vanishes; it carries no power, so drop it rather than divide 0 by 0
        eps = 1e-9 * len(t)
        S[i0:i0 + batch] = dt_eff * 0.5 * (np.divide(C**2, CC, out=np.zeros_like(CC), where=CC > eps)
                                           + np.divide(Sn**2, SS, out=np.zeros_like(SS), where=SS > eps))
    return S

def add_noise(ph, shot_noise_asd, delta_t, rng):
    return ph + rng.normal(0.0, shot_noise_asd / np.sqrt(delta_t), size=len(ph))

# ── Noise floor (stretch level, as in scaffold_multimode) ─────────────────────
NOISE = dict(asd=1e-5, label='stretch (1e-5)', color='#1b5e20', lw=0.5)

# ── Run every cadence ─────────────────────────────────────────────────────────
rng = np.random.default_rng(SEED)
for c in cadences:
    name = (f"delta = {c['par']:g} s" if c['kind'] == 'jitter'
            else f"T = {c['par'][0]:g}/{c['par'][1]:g} s")
    c['name']   = name
    t_meas      = c['t_launch'] + 2*T
    phase_raw   = phase_differences(c['t_launch'], f'phases: {name}')
    uldm        = uldm_phase_vec(t_meas, f_phi, m_phi)
    T_mean      = np.diff(t_meas).mean()
    f_k         = np.linspace(F_LO, F_HI, int(4 * (F_HI - F_LO) * (t_meas[-1] - t_meas[0])))   # 4 points per 1/T_span
    c['f_k']        = f_k
    c['f_N']        = 0.5 / T_mean
    c['urad_raw']   = np.sqrt(ls_psd(t_meas, phase_raw, f_k)) * 1e6
    c['urad_uldm']  = np.sqrt(ls_psd(t_meas, uldm, f_k)) * 1e6
    c['urad_noise'] = np.sqrt(ls_psd(t_meas, add_noise(phase_raw + uldm, NOISE['asd'], T_mean, rng), f_k)) * 1e6
done_work = total_work;  show_progress('done');  print()

for c in cadences:
    i_phi = np.argmin(np.abs(c['f_k'] - f_phi))
    print(f"  {c['name']:>16}: max GGN {c['urad_raw'].max():.4g}, ULDM at f_phi "
          f"{c['urad_uldm'][i_phi]:.4g}, median noisy {np.median(c['urad_noise']):.4g}  urad/rtHz")

# ── Plotting (scaffold_multimode style) ───────────────────────────────────────
COLORS = dict(
    uldm        = '#1f4e9c',   # blue  -- f_phi (ULDM signal), always
    fundamental = '#c1272d',   # red   -- scaffold vibration modes, always
)
AXIS_LABEL_FONTSIZE = 20
GGN_LW  = 2.2
ULDM_LW = 2.2

def plot_panel(ax, c, y_min, y_max):
    ax.plot(c['f_k'], c['urad_noise'], color=NOISE['color'], lw=NOISE['lw'], zorder=3)
    ax.plot(c['f_k'], c['urad_raw'], color=COLORS['fundamental'], lw=GGN_LW, zorder=4)
    ax.plot(c['f_k'], c['urad_uldm'], color=COLORS['uldm'], lw=ULDM_LW, zorder=4)
    ax.set_yscale('log')
    ax.set_xlim(0, F_HI)
    ax.set_ylim(y_min, y_max)
    ax.axvline(c['f_N'], color='k', ls='--', lw=0.5, alpha=0.6)
    ax.text(c['f_N'], y_max * 0.5, r'  $f_N$', fontsize=8, ha='left', va='center')
    ax.text(0.02, 0.95, c['name'], transform=ax.transAxes, fontsize=14, ha='left', va='top')

def stacked_figure(cs, out_name):
    y_min = 0.1 * NOISE['asd'] * 1e6
    y_max = 3 * max(max(c['urad_raw'].max(), c['urad_uldm'].max(), c['urad_noise'].max()) for c in cs)
    fig, axs = plt.subplots(len(cs), 1, figsize=(10, 5 * len(cs)), sharex=True, tight_layout=True)
    for ax, c in zip(axs, cs):
        plot_panel(ax, c, y_min, y_max)
        ax.set_ylabel(r'$\sqrt{S}$ [µrad / $\sqrt{\rm Hz}$]', fontsize=AXIS_LABEL_FONTSIZE)
    axs[-1].set_xlabel('$f$ [Hz]', fontsize=AXIS_LABEL_FONTSIZE)
    axs[0].legend(handles=[
        plt.Line2D([], [], color=NOISE['color'], lw=2.5, label=NOISE['label']),
        plt.Line2D([], [], color=COLORS['fundamental'], lw=GGN_LW, label='scaffold (GGN)'),
        plt.Line2D([], [], color=COLORS['uldm'], lw=ULDM_LW, label='ULDM tone'),
    ], fontsize=8, loc='upper right', frameon=False)
    out = os.path.join(os.path.expanduser('~'), 'Desktop', out_name)
    fig.savefig(out, dpi=200)
    print(f"saved {out}")
    return fig

fig_jitter = stacked_figure([c for c in cadences if c['kind'] == 'jitter'],
                            'scaffold_multimode_jitter.png')
fig_alt    = stacked_figure([c for c in cadences if c['kind'] == 'alt'],
                            'scaffold_multimode_structured.png')

plt.show()
print("\nDone.")
