"""
Stacked jitter figures: Lomb-Scargle periodograms of a 0.04 Hz oscillator, with the
AICE parameters from fig2_final.py (u0 = g*T - v_kick/2 = 21.27 m/s, T = 2.5 s, 70 m
gradiometer, 1 kg source at D = 3 m with 0.5 m vertical amplitude).

Cycle times T_c ~ Uniform(T_nom, T_nom + delta) with T_nom = 5 s: strictly positive
jitter. The jitter makes the sampling non-uniform, so the Lomb-Scargle estimator is
valid above the Nyquist frequency; the spectrum is evaluated out to 0.2 Hz to show the
aliased harmonics.

One linear-y figure per N in STACK_NS (N = 100,000), saved to the Desktop at 1000 dpi as
stacked jitter N{N} lin.png: four panels (delta = 0, 0.1, 0.2, 0.3 s) on a common
y-axis, no noise. For delta > 0 the first alias is shaded gold over the range the jitter
actually spans, from 1/(T_nom + delta) - f_0 to 1/T_nom - f_0; the delta = 0 panel labels
f_0, 2f_0 and their aliases.

Physics model (arm trajectories, point-mass potential, Lomb-Scargle estimator)
reused from cadence_bragg_comparison / fig2_final.py.
"""

import os

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter

# ── constants (AICE params from fig2_final.py) ─────────────────────────────────
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11; g = 9.81
T = 2.5            # half-interferometer time [s]
u0 = g * T - v_kick / 2   # launch speed [m/s]: lower arm lands at t = T_fly (u0 = g*T - v_kick/2)
dt = 0.01
delta_r = 70.0     # gradiometer baseline: IFO2 sits 70 m above IFO1

# source (fig2_final src_common), vertical linear oscillator
M, D_0, h_0, A = 1.0, 3.0, 20.0, 1
f_sig = 0.04   # chosen so the f_0 and 2f_0 aliases do not coincide with other peaks

T_fly = 2 * T
N_fly = int(round(T_fly / dt))
t_local = np.arange(N_fly) * dt

# fig2_final runs back-to-back cycles (T_cyc = T_fly = 5 s). The jitter is
# strictly positive, T_c in [T_nom, T_nom + delta], so a cycle is never shorter
# than the flight (T_nom = T_fly) and cycles never overlap.
T_nom  = 5.0   # shortest cycle [s] = T_fly

def T_mean(delta):
    """Mean cycle time for jitter width delta."""
    return T_nom + delta / 2

# ── trajectory helpers ─────────────────────────────────────────────────────────
def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    """Arm positions on the local [0, 2T) grid. Returns array of length N_fly."""
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0 + k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _  = atom_path(p1[-1] if len(p1) else float(floor),
                        v1 + k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly - len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G * M / np.sqrt(D_0**2 + (z - h)**2)

lower1_loc = arm_positions(0, 0, upper=False)
upper1_loc = arm_positions(0, 0, upper=True)
lower2_loc = arm_positions(delta_r, delta_r, upper=False)
upper2_loc = arm_positions(delta_r, delta_r, upper=True)

# ── phase signal, vectorized over cycles in chunks to bound memory ─────────────
def phases_for(t_starts, chunk=10_000):
    out = np.empty(len(t_starts))
    for i0 in range(0, len(t_starts), chunk):
        t_abs = t_starts[i0:i0 + chunk, None] + t_local[None, :]
        h = h_0 + A * np.cos(2*np.pi * f_sig * t_abs)
        pd1 = V(upper1_loc, h) - V(lower1_loc, h)
        pd2 = V(upper2_loc, h) - V(lower2_loc, h)
        out[i0:i0 + chunk] = (m_atom / hbar) * np.trapezoid(pd1 - pd2, t_local, axis=1)
    return out

# ── Lomb-Scargle periodogram, batched over frequency to bound memory ───────────
def ls_psd(t, y, freqs, batch=200):
    """Scargle (1982) LS PSD; S(f) = dt_eff*(C²/CC + S²/SS)/2.
    Only cos(wt) and sin(wt) are evaluated; the tau shift (a = w*tau) is applied
    afterwards by rotating the sums Σc², Σs², Σcs, Σcy, Σsy."""
    y = y - y.mean()
    dt_eff = (t[-1] - t[0]) / (len(t) - 1)
    S = np.empty_like(freqs)
    for i0 in range(0, len(freqs), batch):
        f_b = freqs[i0:i0 + batch]
        wt = np.outer(2 * np.pi * f_b, t)
        c = np.cos(wt);  s = np.sin(wt)
        Scc = np.einsum('ij,ij->i', c, c)
        Sss = np.einsum('ij,ij->i', s, s)
        Scs = np.einsum('ij,ij->i', c, s)
        Yc = c @ y;  Ys = s @ y
        a = 0.5 * np.arctan2(2 * Scs, Scc - Sss)          # w*tau
        ca = np.cos(a);  sa = np.sin(a)
        C = ca * Yc + sa * Ys
        Sn = ca * Ys - sa * Yc
        CC = ca**2 * Scc + sa**2 * Sss + 2 * ca * sa * Scs
        SS = ca**2 * Sss + sa**2 * Scc - 2 * ca * sa * Scs
        S[i0:i0 + batch] = dt_eff * 0.5 * (C**2 / CC + Sn**2 / SS)
    return S

def freq_grid(f_lo, f_hi, t_meas, f_centers, n_coarse=4000, zoom_cycles=30, n_fine=300,
              f_bands=(), band_oversample=2):
    """Coarse grid over [f_lo, f_hi] plus finely-oversampled windows around
    each frequency in f_centers (peak linewidth is ~1/T_span, which a fixed
    coarse grid undersamples at large N). f_bands: (lo, hi) ranges, e.g. the
    jitter-smeared aliases, sampled at band_oversample points per 1/T_span."""
    T_span     = t_meas[-1] - t_meas[0]
    coarse     = np.linspace(f_lo, f_hi, n_coarse)
    half_width = zoom_cycles / T_span
    pieces     = [coarse]
    for lo, hi in f_bands:
        lo, hi = max(f_lo, lo), min(f_hi, hi)
        if hi > lo:
            pieces.append(np.linspace(lo, hi, int(np.ceil(band_oversample * (hi - lo) * T_span)) + 2))
    for fc in f_centers:
        if f_lo <= fc <= f_hi:
            pieces.append(np.linspace(max(f_lo, fc - half_width),
                                       min(f_hi, fc + half_width), n_fine))
    return np.unique(np.concatenate(pieces))

# ── cadence ────────────────────────────────────────────────────────────────────
def random_cadence(delta, N_cycles, seed=0):
    rng = np.random.default_rng(seed)
    T_cycles = rng.uniform(T_nom, T_nom + delta, N_cycles)
    return np.concatenate([[0.0], np.cumsum(T_cycles[:-1])]) + T_fly

# ── frequency range and zoom targets ───────────────────────────────────────────
F_LO, F_HI = 1e-3, 0.2
f_s = 1.0 / T_nom   # sampling rate of the uniform (delta = 0) case

def f_s_of(delta):
    """Mean sampling rate for jitter width delta."""
    return 1.0 / T_mean(delta)

def zoom_centers(delta):
    """Harmonics k*f_sig and their aliases |k*f_sig - m*f_s| inside [F_LO, F_HI]."""
    fs = f_s_of(delta)
    return sorted({
        round(abs(k * f_sig - m * fs), 9)
        for k in range(1, 6) for m in range(-3, 4)
        if F_LO <= abs(k * f_sig - m * fs) <= F_HI
    })

ALIAS_ORDERS = 2    # first alias of f_0 and of 2f_0 get a finely sampled band

def alias_bands(delta):
    """Frequency ranges the k-th harmonic's first alias sweeps as T_c runs over
    [T_nom, T_nom + delta]: |k*f_0 - 1/T_c|, i.e. 1/(T_nom+delta) - k*f_0 to 1/T_nom - k*f_0."""
    if delta == 0:
        return []
    bands = []
    for k in range(1, ALIAS_ORDERS + 1):
        a, b = abs(k * f_sig - 1 / (T_nom + delta)), abs(k * f_sig - 1 / T_nom)
        bands.append((min(a, b), max(a, b)))
    return bands

grid_spectra = {}   # (delta, N) -> (f_grid, S, {}), filled by get_spectrum

# ── plot style (follows the main figure of fig2_final.py) ─────────────────────
COLORS = dict(
    fundamental = '#c1272d',   # red -- oscillator spectrum
)
Y_LABEL = r'$\sqrt{S_k}$ [$\mu$rad/$\sqrt{\mathrm{Hz}}$]'
X_LABEL = '$f$ [Hz]'

# ── stacked jitter figures: delta = 0, 0.1, 0.2, 0.3 s, one N per figure ───────
STACK_DELTAS = [0.0, 0.1, 0.2, 0.3]
STACK_NS     = [100_000]
FIG_SIZE     = (3.4, 9.0)   # [in] one column wide and tall, for a two-column paper

def get_spectrum(d, n):
    """Clean LS spectrum for (delta, N), reusing the grid above when available."""
    if (d, n) not in grid_spectra:
        print(f"stacked: delta = {d:g} s, N = {n:,} ...", flush=True)
        t_m = random_cadence(d, n)
        f_g = freq_grid(F_LO, F_HI, t_m, f_centers=zoom_centers(d), f_bands=alias_bands(d),
                        n_coarse=4000 if n <= 10_000 else 40000)
        grid_spectra[(d, n)] = (f_g, ls_psd(t_m, phases_for(t_m - T_fly), f_g), {})
    f_g, S, _ = grid_spectra[(d, n)]
    return f_g, np.sqrt(S) * 1e6

def plot_stacked(n, log_y):
    spectra = [get_spectrum(d, n) for d in STACK_DELTAS]
    ymax = max(sp.max() for _, sp in spectra)
    y_exp = int(np.floor(np.log10(1.25 * ymax)))      # power of ten shown once, top left
    fig, axs = plt.subplots(len(STACK_DELTAS), 1, figsize=FIG_SIZE, dpi=200,
                            sharex=True, sharey=True)
    for ax, d, (f_g, sp) in zip(axs, STACK_DELTAS, spectra):
        ax.plot(f_g, sp, color=COLORS['fundamental'], lw=0.8, zorder=4)
        if d:                                     # delta = 0: the alias is a sharp line, no band
            # the first alias sits at 1/T_c - f_0 for each cycle time T_c in [T_nom, T_nom + d]
            ax.axvspan(1 / (T_nom + d) - f_sig, 1 / T_nom - f_sig, color='gold', alpha=0.3, lw=0, zorder=0)
        pm = ''   # one-sided jitter: T_c in [T_nom, T_nom + delta]
        ax.text(0.5, 0.9, rf'$\delta = {pm}{d:g}\,\mathrm{{s}}$', transform=ax.transAxes,
                fontsize=8, ha='center', va='top')
        ax.tick_params(labelsize=8, right=True)   # y ticks on both sides; none on top
        if not log_y:                             # short tick labels (zero shown as 0) with one shared 10^n
            ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: '0' if v == 0 else f'{v / 10**y_exp:g}'))
    if log_y:
        axs[0].set_yscale('log')
        axs[0].set_ylim(STACK_LOG_FLOOR, 3 * ymax)
    else:
        axs[0].set_ylim(0, 1.25 * ymax)
    axs[0].set_xlim(F_LO, F_HI)
    axs[0].set_xticks([0.05, 0.1, 0.15, 0.2])
    if not log_y:
        axs[0].text(0.012, 0.97, rf'$\times 10^{{{y_exp}}}$', transform=axs[0].transAxes, fontsize=8, ha='left', va='top')   # inside the top panel

    # delta = 0 (top panel): label the main peak, the 2f_0 peak and both aliases
    f_top, sp_top = spectra[0]
    for f_t, label, off, ha in [(f_sig,           r'$f_0$',        (-3, 6), 'right'),
                                (2 * f_sig,       r'$2f_0$',       (0, 6),  'center'),
                                (f_s - 2 * f_sig, r'$2f_0$ (alias)', (0, 6), 'center'),
                                (f_s - f_sig,     r'$f_0$ (alias)', (-4, 6), 'right')]:
        near = np.abs(f_top - f_t) < 0.002
        y_t = sp_top[near].max()
        axs[0].scatter([f_top[near][sp_top[near].argmax()]], [y_t], color=COLORS['fundamental'],
                       s=7, zorder=5)
        axs[0].annotate(label, (f_t, y_t), textcoords='offset points', xytext=off,
                        ha=ha, fontsize=7, color=COLORS['fundamental'])
    axs[-1].set_xlabel(X_LABEL, fontsize=9)
    fig.supylabel(Y_LABEL, fontsize=9, x=0.02)
    fig.subplots_adjust(left=0.17, right=0.955, top=0.985, bottom=0.06, hspace=0.1)
    out_path = os.path.join(os.path.expanduser('~'), 'Desktop',
                            f"stacked jitter N{n} {'log' if log_y else 'lin'}.png")
    fig.savefig(out_path, dpi=1000)   # dpi only; figure size is exactly FIG_SIZE
    print(f"saved {out_path}", flush=True)
    return fig

STACK_LOG_FLOOR = 0.1     # [urad/sqrt(Hz)]; clips only the deepest window nulls
stack_figs = [plot_stacked(n, log_y=False) for n in STACK_NS]   # linear y only

plt.show()
