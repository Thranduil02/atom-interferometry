"""
Variable cycle time interferometer + Lomb–Scargle.

Each cycle has a random total duration T_c ~ Uniform(1.9, 3.0) s.
The atom flies for the fixed interferometry window 2T = 1.46 s;
the remainder of each cycle is ground time (atom at rest on floor).

Because T_c varies, the measurement times
    t_m^(k) = Σ_{i<k} T_c^(i)  +  2T
are non-uniformly spaced → ideal use-case for Lomb–Scargle.

The phase for cycle k is accumulated only during its 2T window;
the local atom trajectories are identical for every cycle (same
initial conditions), but the oscillating-mass phase at the start
of each cycle is different due to the random ground-time offsets.
"""

import numpy as np
import matplotlib.pyplot as plt

# ── constants ──────────────────────────────────────────────────────────────────
m_atom = 1.46e-25;  hbar = 1.055e-34
v_kick = 1000 * hbar * 2*np.pi / (698e-9 * m_atom)
G = 6.67e-11; g = 9.81; M = 1; h_0 = 1; D_0 = 5; A = 1; f_sig = 0.1
u0 = 3.86; dt = 0.01; T = 0.73

T_fly = 2 * T          # fixed interferometry window duration
N_fly = int(round(T_fly / dt))   # samples in [0, 2T]
t_local = np.arange(N_fly) * dt  # local time grid [0, 2T)

# ── trajectory helpers ─────────────────────────────────────────────────────────
def atom_path(z0, u, t0, t1, floor):
    z, v, zs = z0, u, []
    for _ in np.arange(t0, t1, dt):
        z += v*dt - 0.5*g*dt**2;  v -= g*dt
        if z <= floor and v < 0:  z = floor;  v = 0;  break
        zs.append(z)
    return np.array(zs), v

def arm_positions(z0, floor, upper=False):
    """
    Arm positions on the local [0, 2T) grid.
    Returns array of length N_fly.
    """
    k1 = v_kick if upper else 0.0
    p1, v1 = atom_path(z0, u0 + k1, 0, T, floor)
    k2 = -v_kick if upper else v_kick
    p2, _  = atom_path(p1[-1] if len(p1) else float(floor),
                        v1 + k2, T, T_fly, floor)
    path = np.concatenate([p1, p2])
    if len(path) < N_fly:
        path = np.concatenate([path, np.full(N_fly - len(path), float(floor))])
    return path[:N_fly]

def V(z, h):
    return -G * M / np.sqrt(D_0**2 + (z - h)**2)

# ── pre-compute arm positions for one cycle (reused for every cycle) ───────────
lower1_loc = arm_positions(0, 0, upper=False)
upper1_loc = arm_positions(0, 0, upper=True)
lower2_loc = arm_positions(5, 5, upper=False)
upper2_loc = arm_positions(5, 5, upper=True)

# ── LS helper ─────────────────────────────────────────────────────────────────
def ls_psd(t, y, freqs):
    """Scargle (1982) LS PSD; S(f) = dt_eff*(C²/CC + S²/SS)/2."""
    y = y - y.mean()
    dt_eff = (t[-1] - t[0]) / (len(t) - 1)
    w = 2 * np.pi * freqs
    wt = np.outer(w, t)
    tau = np.arctan2(np.sin(2*wt).sum(1), np.cos(2*wt).sum(1)) / (2 * w)
    sh = wt - (w * tau)[:, None]
    ct = np.cos(sh);  st = np.sin(sh)
    C = ct @ y;  S = st @ y
    CC = (ct**2).sum(1);  SS = (st**2).sum(1)
    return dt_eff * 0.5 * (C**2 / CC + S**2 / SS)

# ── generate random cycle times ───────────────────────────────────────────────
rng = np.random.default_rng(0)
N_cycles = 1500
T_min, T_max = 1.9, 3.0
assert T_min >= T_fly, "Cycle time must be ≥ 2T = 1.46 s"

T_cycles = rng.uniform(T_min, T_max, N_cycles)   # (N_cycles,)

# Absolute start time of each cycle's interferometry window
t_starts  = np.concatenate([[0.0], np.cumsum(T_cycles[:-1])])
# Measurement tagged at the END of the 2T interferometry window
t_meas    = t_starts + T_fly                      # non-uniform!

# ── compute phase for each cycle ──────────────────────────────────────────────
phases = np.zeros(N_cycles)
for k in range(N_cycles):
    # Absolute time during this cycle's interferometry window
    t_abs = t_starts[k] + t_local
    h_k   = h_0 + A * np.cos(2*np.pi * f_sig * t_abs)

    # Potential difference: (upper − lower) for each source
    pd1 = V(upper1_loc, h_k) - V(lower1_loc, h_k)
    pd2 = V(upper2_loc, h_k) - V(lower2_loc, h_k)

    # Phase = (m/ħ) ∫₀^{2T} (Δ₁ − Δ₂) dt'   (trapezoid rule)
    phases[k] = (m_atom / hbar) * np.trapezoid(pd1 - pd2, t_local)

# ── Lomb–Scargle on non-uniform measurement times ─────────────────────────────
# Frequency grid: from ~1/T_span to well above f_sig
T_span    = t_meas[-1] - t_meas[0]
dt_median = np.median(np.diff(t_meas))
f_min  = 0.5 / T_span
f_max  = 1.0 / dt_median          # ≈ 1/<T_c> (not a strict Nyquist; just exploration)
f_grid = np.linspace(f_min, f_max, 7500)

S_ls = ls_psd(t_meas, phases, f_grid)

# ── naive FFT (treating non-uniform data as if uniform) ───────────────────────
# Uses effective mean spacing; misleading but shown for comparison.
dt_eff    = T_span / (N_cycles - 1)
f_fft_nu  = np.fft.rfftfreq(N_cycles, d=dt_eff)
S_fft_nu  = (dt_eff / N_cycles) * np.abs(np.fft.rfft(phases - phases.mean()))**2
mask_nu   = (f_fft_nu > 0) & (f_fft_nu <= f_max)
f_fft_nu  = f_fft_nu[mask_nu]
S_fft_nu  = S_fft_nu[mask_nu]

# ── plot style ────────────────────────────────────────────────────────────────
warm_background = True   # set True to use off-white background (#fdfcf3) on all plots
if warm_background:
    plt.rcParams['figure.facecolor'] = '#fdfcf3'
    plt.rcParams['axes.facecolor']   = '#fdfcf3'

# ── diagnostic figure (3 panels: histogram, spacings, phase) ──────────────────
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

ax = axes[0]
ax.hist(T_cycles, bins=20, color='steelblue', edgecolor='k', alpha=0.8)
ax.axvline(T_fly, color='firebrick', lw=2, ls='--', label=r'$2T = 1.46$ s')
ax.set_xlabel('Cycle time [s]', fontsize=13)
ax.set_ylabel('Count', fontsize=13)
ax.set_title(f'Cycle times ~ Uniform({T_min}, {T_max}) s', fontsize=13)
ax.legend(fontsize=11)

ax = axes[1]
ax.plot(np.diff(t_meas), 'o', ms=4, color='seagreen', alpha=0.7)
ax.axhline(2.0, color='k', ls='--', lw=1, label='Uniform (2.0 s)')
ax.set_xlabel('Cycle index', fontsize=13)
ax.set_ylabel(r'$\Delta t_{\rm meas}$ [s]', fontsize=13)
ax.set_title('Measurement time spacings', fontsize=13)
ax.legend(fontsize=11)

ax = axes[2]
ax.plot(t_meas, phases * 1e6, 'o', ms=5, color='firebrick', alpha=0.8)
ax.set_xlabel('$t$ [s]', fontsize=13)
ax.set_ylabel(r'$\Delta\Phi$ [$\mu$rad]', fontsize=13)
ax.set_title('Phase at irregular times', fontsize=13)

for ax in axes:
    ax.tick_params(labelsize=11)
fig.tight_layout()
plt.show()

# ── periodogram figure (FFT and LS on separate panels) ────────────────────────
fig, (ax_fft, ax_ls) = plt.subplots(1, 2, figsize=(14, 5), sharey=True)

ax_fft.plot(f_fft_nu, np.sqrt(S_fft_nu), color='steelblue', lw=1.5)
ax_fft.axvline(f_sig, ls='--', color='k', lw=1, label=rf'$f={f_sig}$ Hz')
ax_fft.set_xlabel('$f$ [Hz]', fontsize=14)
ax_fft.set_ylabel(r'$\sqrt{S}$ [rad/$\sqrt{\mathrm{Hz}}$]', fontsize=14)
ax_fft.set_title('FFT (ignores irregular spacing)', fontsize=13)
ax_fft.legend(fontsize=12)

ax_ls.plot(f_grid, np.sqrt(S_ls), color='firebrick', lw=1.5)
ax_ls.axvline(f_sig, ls='--', color='k', lw=1, label=rf'$f={f_sig}$ Hz')
ax_ls.set_xlabel('$f$ [Hz]', fontsize=14)
ax_ls.set_title('Lomb–Scargle', fontsize=13)
ax_ls.legend(fontsize=12)

for ax in (ax_fft, ax_ls):
    ax.tick_params(labelsize=12)
fig.tight_layout()
plt.show()

i_peak = np.argmax(S_ls)
print(f"LS peak at f = {f_grid[i_peak]:.4f} Hz  (signal at {f_sig} Hz)")
print(f"Median cycle time: {np.median(T_cycles):.3f} s")
print(f"Non-uniform measurement times: {t_meas[0]:.2f} – {t_meas[-1]:.2f} s")

# ── tau diagnostic ────────────────────────────────────────────────────────────
w_all  = 2 * np.pi * f_grid
wt_all = np.outer(w_all, t_meas)   # (N_freq, N_cycles)

tau_all = np.arctan2(
    np.sin(2 * wt_all).sum(axis=1),
    np.cos(2 * wt_all).sum(axis=1)
) / (2 * w_all)                     # (N_freq,)

fig, ax = plt.subplots(figsize=(12, 4))

ax.plot(f_grid, tau_all, color='darkorchid', lw=0.8, alpha=0.9)
ax.axvline(f_sig, ls='--', color='k', lw=1, label=rf'$f_0 = {f_sig}$ Hz')
ax.set_xlabel('$f$ [Hz]', fontsize=13)
ax.set_ylabel(r'$\tau(f)$ [s]', fontsize=13)
ax.set_title(r'Phase offset $\tau(f)$ across the frequency grid', fontsize=13)
ax.legend(fontsize=11)
ax.tick_params(labelsize=11)

fig.tight_layout()
plt.show()

print(f"tau range: {tau_all.min():.4f} to {tau_all.max():.4f} s")
